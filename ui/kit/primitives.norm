package ui.kit

import ui.Widget
import ui.WidgetBuilder
import ui.WidgetRole
import ui.NativeWidget
import ui.View
import ui.ViewContent
import ui.describe
import ui.describeChildren
import ui.componentBinding
import ui.Binding
import std.core.Exception
import std.build.BuildWith

value Text implements NativeWidget {
  String text
  WidgetRole role

  Text(String text) { this.text = text role = WidgetRole.Default }
  Text(String text, WidgetRole role) { this.text = text this.role = role }

  View nativeView() { View(content: ViewContent.Text(text), role: role) }
}


value Column implements NativeWidget {
  List<Widget> children
  WidgetRole role
  Boolean enabled

  Column(@BuildWith(WidgetBuilder.class) Function<List<Widget>()> content, WidgetRole role = WidgetRole.Default, Boolean enabled = true) {
    children = content()
    this.role = role
    this.enabled = enabled
  }

  Column(List<Widget> children) { this.children = children role = WidgetRole.Default enabled = true }
  Column(List<Widget> children, WidgetRole role, Boolean enabled = true) {
    this.children = children
    this.role = role
    this.enabled = enabled
  }

  View nativeView() {
    View(content: ViewContent.Column(describeChildren(children)), role: role, enabled: enabled)
  }
}


value Row implements NativeWidget {
  List<Widget> children
  WidgetRole role

  Row(@BuildWith(WidgetBuilder.class) Function<List<Widget>()> content, WidgetRole role = WidgetRole.Default) {
    children = content()
    this.role = role
  }

  Row(List<Widget> children) { this.children = children role = WidgetRole.Default }
  Row(List<Widget> children, WidgetRole role) { this.children = children this.role = role }

  View nativeView() { View(content: ViewContent.Row(describeChildren(children)), role: role) }
}


value Scroll implements NativeWidget {
  Widget child
  View nativeView() { View(content: ViewContent.Scroll(describe(child))) }
}


value TextArea implements NativeWidget {
  String placeholder
  Binding<String> value
  Integer rows = 6
  Boolean editable = true

  View nativeView() {
    if rows < 1 || rows > 40 { throw Exception(message: "text area row count is outside 1..40") }
    View(content: ViewContent.Multiline(placeholder: placeholder, text: componentBinding<String>(value), rows: rows, editable: editable))
  }
}
