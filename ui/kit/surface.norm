package ui.kit

import ui.Widget
import ui.NodeKey
import ui.kit.fx.Surface as SurfaceControl
import ui.kit.fx.surfaceNew

value Surface implements Widget {
  Widget content
  String styleClass = ""
  Double minimumHeight = 0.0
  NodeKey? key = null
  Widget build() {
    nativeComponent<SurfaceControl>(kind: "ui.kit.Surface", create: () { surfaceNew() },
      node: (control) { control }, update: (control, scope) {
        control.setClassName(styleClass)
        control.setMinHeight(minimumHeight)
      }, children: [content], arrange: (control, nodes) { control.setContent(nodes[0]) },
      close: (control) {}, key: key)
  }
}
