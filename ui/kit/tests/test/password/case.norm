package ui.kit.test.password

import std.testing.Test
import std.core.Exception
import ui.Widget
import ui.Binding
import ui.Renderer
import ui.fx.JavaFxBackend
import ui.fx.JavaFxScheduler
import ui.fx.fxHandle
import ui.fx.FxApplication
import ui.fx.withFxRuntime
import ui.kit.Input
import fx.controls.TextField
import fx.controls.PasswordField

class PasswordState { String text = "local-test" Boolean completed = false String? failure = null }

@Test
Void masksAndBindsPasswordInput() {
  withFxRuntime(() {
    var application = FxApplication("Password input")
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var state = PasswordState()
    Binding<String> value = Binding<String>(read: () { state.text }, write: (String next) { state.text = next })
    application.run(build: () {
      try {
      renderer.render(Input(placeholder: "密钥", value: value, password: true).build())
      var control = fxHandle(renderer.node()).nativeNode()
      switch control {
        case PasswordField field {
          require(condition: field.getText() == "local-test", message: "initial value reaches field")
          field.setText("edited-test")
          require(condition: state.text == "edited-test", message: "native changes update binding")
        }
        case _ { require(condition: false, message: "password field supports text input") }
      }
      state.completed = true
      } catch Exception failure { state.failure = failure.message }
      finally { application.close() }
    }, dispose: renderer.close)
    require(condition: state.completed && state.failure == null,
      message: if state.failure == null { "Password verification did not complete" } else { state.failure!! })
  })
}
