package ui.kit.test.inputs

import std.testing.Test
import ui.Widget
import ui.Binding
import ui.kit.Column as UiColumn
import ui.kit.Input
import ui.kit.Checkbox
import ui.kit.Select
import ui.kit.Form
import ui.kit.FormField
import ui.kit.FormFieldState

class Cell<T> { T value }

@Test
Void inputWidgetsExposeNormBindings() {
  var name = Cell<String>(value: "初始")
  var accepted = Cell<Boolean>(value: false)
  Binding<String> text = Binding<String>(read: () { name.value }, write: (String next) { name.value = next })
  Binding<Boolean> checked = Binding<Boolean>(read: () { accepted.value }, write: (Boolean next) { accepted.value = next })
  Widget input = Input(placeholder: "姓名", value: text)
  Widget checkbox = Checkbox(text: "同意", value: checked)
  text.value = "更新"
  checked.value = true
  require(condition: name.value == "更新" && accepted.value, message: "state stays in Norm bindings")
}

@Test
Void formValidatesSubmitsAndResetsTypedValues() {
  var name = Cell<String>(value: "Alice")
  var submitted = Cell<Integer>(value: 0)
  Binding<String> text = Binding<String>(read: () { name.value }, write: (String next) { name.value = next })
  var state = FormFieldState<String>(initial: name.value)
  var field = FormField<String>(name: "name", state: state, control: Input(placeholder: "姓名", value: text), value: text,
    validator: (String current) { current != "" && current != "A" }, error: "姓名至少两字")
  var form = Form(fields: [field], onSubmit: () { submitted.value = submitted.value + 1 })
  var fieldView = field.build()
  fieldView.build()
  require(condition: form.validate(), message: "initial field is valid")
  name.value = "A"
  require(condition: !form.submit() && submitted.value == 0 && state.invalid, message: "invalid form does not submit")
  var errorVisible = false
  switch fieldView.build() {
    case UiColumn column { errorVisible = true }
    case _ {}
  }
  require(condition: errorVisible, message: "field view follows the stable validation model")
  var redrawn = Form(fields: [FormField<String>(name: "name", state: state,
    control: Input(placeholder: "更新姓名", value: text), value: text,
    validator: (String current) { current != "" && current != "A" }, error: "姓名至少两字")],
    onSubmit: () { submitted.value = submitted.value + 1 })
  require(condition: state.invalid && !redrawn.validate(), message: "validation survives rebuilt field descriptions")
  name.value = "Bob"
  require(condition: redrawn.submit() && submitted.value == 1 && !state.invalid, message: "valid form submits once")
  redrawn.reset()
  require(condition: name.value == "Alice" && !state.invalid, message: "reset restores the initial typed value")
}

@Test
Void selectKeepsTypedOptionsAndSelection() {
  var chosen = Cell<String?>(value: null)
  Binding<String?> value = Binding<String?>(read: () { chosen.value }, write: (String? next) { chosen.value = next })
  Widget select = Select<String>(options: ["北京", "上海", "广州"], value: value)
  value.value = "上海"
  require(condition: chosen.value == "上海", message: "typed select binding accepts options")
}
