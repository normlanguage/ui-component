package ui.kit.test.tabs

import std.testing.Test
import std.core.Exception
import ui.Binding
import ui.Renderer
import ui.fx.FxApplication
import ui.fx.withFxRuntime
import ui.fx.JavaFxBackend
import ui.fx.JavaFxScheduler
import ui.fx.fxHandle
import ui.kit.fx.Tabs as TabsControl
import fx.controls.ScrollPane
import fx.controls.TextArea as TextAreaControl
import ui.View
import ui.NativeView
import ui.Widget
import ui.ViewContent
import ui.describe
import ui.kit.Tab
import ui.kit.Tabs
import ui.kit.Text
import ui.kit.TextArea

@Test
Void tabPagesHaveOneScrollingOwner() {
  var selected = Binding<Integer>(read: () { 0 }, write: (Integer next) {})
  var inner = Tabs(tabs: [Tab(title: "Editor", content: Text("Draft"))], selected: selected)
  var outer = Tabs(tabs: [Tab(title: "Settings", content: inner, scroll: false)], selected: selected)
  switch describe(outer.build()).content {
    case Native(NativeView parent) {
      switch parent.children()[0].content {
        case WidgetObject(Widget widget) {
          switch widget { case Tabs child {
          switch describe(child.build()).content {
            case Native(NativeView nested) {
              switch nested.children()[0].content {
                case Scroll(_) {}
                case _ { require(condition: false, message: "The inner tab owns scrolling") }
              }
            }
            case _ { require(condition: false, message: "Nested tabs retain their native component") }
          }
          } case _ { require(condition: false, message: "Nested content remains a tab widget") } }
        }
        case _ { require(condition: false, message: "Outer tabs leave scrolling to the nested page") }
      }
    }
    case _ { require(condition: false, message: "Tabs use the canonical native component") }
  }
}

@Test
Void rejectsInvalidTabSelection() {
  var selected = Binding<Integer>(read: () { 1 }, write: (Integer next) {})
  Boolean rejected = false
  try { Tabs(tabs: [Tab(title: "Only", content: Text("Page"))], selected: selected).build() }
  catch Exception failure { rejected = true }
  require(condition: rejected, message: "Selection must refer to an existing page")
}

@Test
Void multilineInputPreservesTextAndEditability() {
  var value = Binding<String>(read: () { "one\r\ntwo\nthree" }, write: (String next) {})
  var input = TextArea(placeholder: "Draft", value: value, rows: 8, editable: false)
  switch input.nativeView().content {
    case Multiline(_, Binding<String> binding, Integer rows, Boolean editable) {
      require(condition: binding.value == "one\r\ntwo\nthree" && rows == 8 && !editable,
        message: "Multiline content reaches the renderer without text normalization")
    }
    case _ { require(condition: false, message: "Multiline input uses the shared renderer contract") }
  }
}

class TabState { Integer selected = 0 String draft = "initial" Boolean completed = false String? failure = null }

@Test
Void nativeTabsRetainEditingBuffersAndScrollOwners() {
  withFxRuntime(() {
    var application = FxApplication("Tabs state verification")
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var state = TabState()
    var selected = Binding<Integer>(read: () { state.selected }, write: (Integer next) { state.selected = next })
    var text = Binding<String>(read: () { state.draft }, write: (String next) { state.draft = next })
    List<Tab> pages = [Tab(title: "Editor", content: TextArea(placeholder: "Draft", value: text)),
      Tab(title: "Nested", content: Text("Page"), scroll: false)]
    application.run(build: () {
      try {
        renderer.render(Tabs(tabs: pages, selected: selected).build())
        var node = fxHandle(renderer.node()).nativeNode()
        switch node {
          case TabsControl control {
            var first = control.getTabs()!!.get(0)!!.getContent()
            switch first {
              case ScrollPane scroll {
                switch scroll.getContent() {
                  case TextAreaControl editor {
                    editor.setText("edited\ntext")
                    require(condition: state.draft == "edited\ntext", message: "Editing uses the canonical binding")
                    control.getSelectionModel()!!.select(1)
                    require(condition: state.selected == 1, message: "Native selection updates page state")
                    renderer.render(Tabs(tabs: pages, selected: selected).build())
                    require(condition: control.getTabs()!!.get(0)!!.getContent() == first,
                      message: "Switching pages retains the original scrolling host and editing buffer")
                    require(condition: editor.getText() == "edited\ntext", message: "The draft survives reconciliation")
                    renderer.render(Tabs(tabs: [pages[1], pages[0]], selected: selected).build())
                    require(condition: state.selected == 1 && control.getSelectionModel()!!.getSelectedIndex() == 1,
                      message: "Native projection does not overwrite the selected index during reordering")
                    require(condition: control.getTabs()!!.get(1)!!.getContent() == first,
                      message: "Reordering retains the editor page identity")
                  }
                  case _ { require(condition: false, message: "The editor remains a native multiline field") }
                }
              }
              case _ { require(condition: false, message: "The editor tab owns a scrolling host") }
            }
            switch control.getTabs()!!.get(0)!!.getContent() {
              case ScrollPane scroll { require(condition: false, message: "A non-scrolling tab must not add a scroll host") }
              case _ {}
            }
          }
          case _ { require(condition: false, message: "Tabs use the canonical kit control") }
        }
        state.completed = true
      } catch Exception failure { state.failure = failure.message }
      finally { application.close() }
    }, dispose: renderer.close)
    require(condition: state.completed && state.failure == null,
      message: if state.failure == null { "Native tabs verification did not complete" } else { state.failure!! })
  })
}
