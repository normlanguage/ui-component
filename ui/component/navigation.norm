package ui.component

import ui.Widget
import ui.NodeKey
import ui.Binding
import ui.component.fx.AnchorHost
import ui.component.fx.Breadcrumb as BreadcrumbControl
import ui.component.fx.DropdownHost
import ui.component.fx.Menu as MenuControl
import ui.component.fx.Pagination as PaginationControl
import ui.component.fx.Steps as StepsControl
import ui.component.fx.Tabs as TabsControl
import ui.component.fx.IndexLink
import ui.component.fx.breadcrumbNew
import ui.component.fx.menuNew
import ui.component.fx.paginationNew
import ui.component.fx.navigationLayoutAdapterCreateSteps
import ui.component.fx.tabsNew
import ui.component.fx.navigationLayoutAdapterAnchorHost
import ui.component.fx.navigationLayoutAdapterAnchor
import ui.component.fx.navigationLayoutAdapterAnchorSelection
import ui.component.fx.navigationLayoutAdapterBreadcrumb
import ui.component.fx.navigationLayoutAdapterDropdown
import ui.component.fx.navigationLayoutAdapterDropdownContent
import ui.component.fx.navigationLayoutAdapterMenuGroup
import ui.component.fx.navigationLayoutAdapterClearMenu
import ui.component.fx.navigationLayoutAdapterPaginationSelection
import ui.component.fx.navigationLayoutAdapterSteps
import ui.component.fx.navigationLayoutAdapterStepsSelection
import ui.component.fx.navigationLayoutAdapterTabs
import ui.component.fx.navigationLayoutAdapterTabsSelection
import ui.component.fx.hostItems
import ui.component.fx.utilCloseNode

value AnchorSection {
  String title
  Widget content
}

private class AnchorBindingHost {
  AnchorHost control
  IndexLink selection
  Integer selected = 0
  Function<Void(Integer?)> changed = (index) {}
}

value Anchor implements Widget {
  List<AnchorSection> sections
  Binding<Integer>? selected = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<AnchorBindingHost>(kind: "ui.component.Anchor",
      create: () {
        var control = navigationLayoutAdapterAnchorHost()!!
        AnchorBindingHost(control: control, selection: navigationLayoutAdapterAnchorSelection(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        var current = selected
        if current != null {
          host.selected = current.value
          host.changed = scope.bind((Integer? next) { if next != null { current.value = next!! } })
        }
      }, children: [for (section : sections) section.content],
      arrange: (host, nodes) {
        navigationLayoutAdapterAnchor(arg0: host.control,
          arg1: hostItems([for (section : sections) section.title]), arg2: hostItems(nodes))
        if selected != null { host.selection.update(arg0: host.selected, arg1: host.changed) }
        else { host.selection.unbind() }
      }, close: (host) { host.selection.close() host.control.close() }, key: key)
  }
}

value BreadcrumbItem {
  String text
  Function<Void()> action
}

value Breadcrumb implements Widget {
  List<BreadcrumbItem> items
  NodeKey? key = null

  Widget build() {
    nativeComponent<BreadcrumbControl>(kind: "ui.component.Breadcrumb",
      create: () { breadcrumbNew() }, node: (control) { control },
      update: (control, scope) {
        var selected = scope.bind((Integer? index) { if index != null { items[index!!].action() } })
        navigationLayoutAdapterBreadcrumb(arg0: control,
          arg1: hostItems([for (item : items) item.text]), arg2: selected)
      }, close: (control) { utilCloseNode(control) }, key: key)
  }
}

value Dropdown implements Widget {
  String text
  Widget content
  NodeKey? key = null

  Widget build() {
    nativeComponent<DropdownHost>(kind: "ui.component.Dropdown",
      create: () { navigationLayoutAdapterDropdown(text)!! }, node: (host) { host.node()!! },
      update: (host, scope) { host.title(text) }, children: [content],
      arrange: (host, nodes) { navigationLayoutAdapterDropdownContent(arg0: host, arg1: nodes[0]) },
      close: (host) { host.close() }, key: key)
  }
}

value MenuItem {
  String text
  Function<Void()> action
}

value MenuGroup {
  String title
  List<MenuItem> items
}

value Menu implements Widget {
  List<MenuGroup> groups
  NodeKey? key = null

  Widget build() {
    nativeComponent<MenuControl>(kind: "ui.component.Menu",
      create: () { menuNew() }, node: (control) { control },
      update: (control, scope) {
        navigationLayoutAdapterClearMenu(control)
        for group : groups {
          var current = group
          var selected = scope.bind((Integer? index) { if index != null { current.items[index!!].action() } })
          navigationLayoutAdapterMenuGroup(arg0: control, arg1: group.title,
            arg2: hostItems([for (item : group.items) item.text]), arg3: selected)
        }
      }, close: (control) { utilCloseNode(control) }, key: key)
  }
}

private class PaginationHost {
  PaginationControl control
  IndexLink selection
}

value Pagination implements Widget {
  Integer totalItems
  Binding<Integer> currentPage
  Integer pageSize = 10
  NodeKey? key = null

  Widget build() {
    nativeComponent<PaginationHost>(kind: "ui.component.Pagination",
      create: () {
        var control = paginationNew(arg0: totalItems, arg1: pageSize)
        PaginationHost(control: control, selection: navigationLayoutAdapterPaginationSelection(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        host.control.setPageSize(pageSize)
        host.control.setTotalItems(totalItems)
        host.selection.update(arg0: currentPage.value,
          arg1: scope.bind((Integer? next) { if next != null { currentPage.value = next!! } }))
      }, close: (host) { host.selection.close() utilCloseNode(host.control) }, key: key)
  }
}

private class StepsHost {
  StepsControl control
  IndexLink selection
}

value Steps implements Widget {
  List<String> titles
  Binding<Integer> currentStep
  NodeKey? key = null

  Widget build() {
    nativeComponent<StepsHost>(kind: "ui.component.Steps",
      create: () {
        var control = navigationLayoutAdapterCreateSteps()!!
        StepsHost(control: control, selection: navigationLayoutAdapterStepsSelection(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        navigationLayoutAdapterSteps(arg0: host.control, arg1: hostItems(titles))
        if !titles.isEmpty() {
          host.selection.update(arg0: currentStep.value,
            arg1: scope.bind((Integer? next) { if next != null { currentStep.value = next!! } }))
        }
      }, close: (host) { host.selection.close() utilCloseNode(host.control) }, key: key)
  }
}

value TabItem {
  String title
  Widget content
}

private class TabsHost {
  TabsControl control
  IndexLink selection
  Integer selected = 0
  Function<Void(Integer?)> changed = (index) {}
}

value Tabs implements Widget {
  List<TabItem> items
  Binding<Integer> selected
  NodeKey? key = null

  Widget build() {
    nativeComponent<TabsHost>(kind: "ui.component.Tabs",
      create: () {
        var control = tabsNew()
        TabsHost(control: control, selection: navigationLayoutAdapterTabsSelection(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        host.selected = selected.value
        host.changed = scope.bind((Integer? next) { if next != null { selected.value = next!! } })
      }, children: [for (item : items) item.content],
      arrange: (host, nodes) {
        navigationLayoutAdapterTabs(arg0: host.control,
          arg1: hostItems([for (item : items) item.title]), arg2: hostItems(nodes))
        if !items.isEmpty() { host.selection.update(arg0: host.selected, arg1: host.changed) }
      }, close: (host) { host.selection.close() utilCloseNode(host.control) }, key: key)
  }
}
