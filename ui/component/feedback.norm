package ui.component

import ui.Widget
import ui.NodeKey
import ui.Binding
import ui.component.fx.OverlayAdapter
import ui.component.fx.overlayAdapterModal
import ui.component.fx.overlayAdapterDrawer
import ui.component.fx.overlayAdapterPopover
import ui.component.fx.overlayAdapterTooltip
import ui.component.fx.overlayAdapterPopconfirm
import ui.component.fx.overlayAdapterTour
import ui.component.fx.hostItems

value Modal implements Widget {
  String title
  Widget anchor
  Widget content
  Binding<Boolean> open
  NodeKey? key = null

  Widget build() {
    nativeComponent<OverlayAdapter>(kind: "ui.component.Modal",
      create: () { overlayAdapterModal(title)!! }, node: (control) { control },
      update: (control, scope) {
        control.setText(title)
        control.setOpen(arg0: open.value, arg1: scope.bind(() { open.value = false }))
      }, children: [anchor, content],
      arrange: (control, nodes) { control.setContent(arg0: nodes[0], arg1: nodes[1]) },
      close: (control) { control.close() }, key: key)
  }
}

enum DrawerSide { Left, Right, Top, Bottom }

private String drawerSideName(DrawerSide side) {
  switch side {
    case Left { break "LEFT" }
    case Right { break "RIGHT" }
    case Top { break "TOP" }
    case Bottom { break "BOTTOM" }
  }
}

value Drawer implements Widget {
  Widget anchor
  Widget content
  Binding<Boolean> open
  DrawerSide side = DrawerSide.Right
  NodeKey? key = null

  Widget build() {
    nativeComponent<OverlayAdapter>(kind: "ui.component.Drawer",
      create: () { overlayAdapterDrawer(drawerSideName(side))!! }, node: (control) { control },
      update: (control, scope) {
        control.setSide(drawerSideName(side))
        control.setOpen(arg0: open.value, arg1: scope.bind(() { open.value = false }))
      }, children: [anchor, content],
      arrange: (control, nodes) { control.setContent(arg0: nodes[0], arg1: nodes[1]) },
      close: (control) { control.close() }, key: key)
  }
}

value Popover implements Widget {
  Widget anchor
  Widget content
  Binding<Boolean> open
  NodeKey? key = null

  Widget build() {
    nativeComponent<OverlayAdapter>(kind: "ui.component.Popover",
      create: () { overlayAdapterPopover()!! }, node: (control) { control },
      update: (control, scope) {
        control.setOpen(arg0: open.value, arg1: scope.bind(() { open.value = false }))
      }, children: [anchor, content],
      arrange: (control, nodes) { control.setContent(arg0: nodes[0], arg1: nodes[1]) },
      close: (control) { control.close() }, key: key)
  }
}

value Tooltip implements Widget {
  Widget anchor
  String text
  Binding<Boolean>? open = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<OverlayAdapter>(kind: "ui.component.Tooltip",
      create: () { overlayAdapterTooltip(text)!! }, node: (control) { control },
      update: (control, scope) {
        control.setText(text)
        var visibility = open
        if visibility != null {
          control.setOpen(arg0: visibility.value, arg1: scope.bind(() { visibility.value = false }))
        } else { control.unbindOpen() }
      }, children: [anchor],
      arrange: (control, nodes) { control.setContent(arg0: nodes[0], arg1: null) },
      close: (control) { control.close() }, key: key)
  }
}

value Popconfirm implements Widget {
  Widget anchor
  String question
  Binding<Boolean> open
  Function<Void()> confirmed
  NodeKey? key = null

  Widget build() {
    nativeComponent<OverlayAdapter>(kind: "ui.component.Popconfirm",
      create: () { overlayAdapterPopconfirm(question)!! }, node: (control) { control },
      update: (control, scope) {
        control.setText(question)
        control.setConfirmed(scope.bind(confirmed))
        control.setOpen(arg0: open.value, arg1: scope.bind(() { open.value = false }))
      }, children: [anchor],
      arrange: (control, nodes) { control.setContent(arg0: nodes[0], arg1: null) },
      close: (control) { control.close() }, key: key)
  }
}

value TourStep {
  Widget target
  String title
  String description
}

value Tour implements Widget {
  List<TourStep> steps
  Binding<Boolean> open
  NodeKey? key = null

  Widget build() {
    nativeComponent<OverlayAdapter>(kind: "ui.component.Tour",
      create: () { overlayAdapterTour()!! }, node: (control) { control },
      update: (control, scope) {
        control.setOpen(arg0: open.value, arg1: scope.bind(() { open.value = false }))
      }, children: [for (step : steps) step.target],
      arrange: (control, nodes) {
        control.setTourSteps(arg0: hostItems([for (step : steps) step.title]),
          arg1: hostItems([for (step : steps) step.description]), arg2: hostItems(nodes))
      }, close: (control) { control.close() }, key: key)
  }
}
