package ui.component.test.inputs_runtime

import std.testing.Test
import std.concurrent.startTask
import std.core.Unit
import std.core.Exception
import ui.Widget
import ui.Binding
import ui.Renderer
import ui.JavaFxBackend
import ui.JavaFxScheduler
import ui.fxHandle
import ui.fx.FxApplication
import ui.fx.withFxRuntime
import ui.component.Input
import ui.component.AutoComplete
import ui.component.Cascader
import ui.component.CascaderOption
import ui.component.Checkbox
import ui.component.ColorPicker
import ui.component.DatePicker
import ui.component.Form
import ui.component.FormField
import ui.component.FormFieldState
import ui.component.InputNumber
import ui.component.Mentions
import ui.component.Radio
import ui.component.Rate
import ui.component.Select
import ui.component.Slider
import ui.component.RangeSlider
import ui.component.NumericRange
import ui.component.Switch
import ui.component.TimePicker
import ui.component.Transfer
import ui.component.TreeSelect
import ui.component.TreeOption
import ui.component.Upload
import ui.component.fx.Input as NativeInput
import ui.component.fx.Select as NativeSelect
import ui.component.fx.TreeSelect as NativeTreeSelect
import ui.component.fx.DatePicker as NativeDatePicker
import ui.component.fx.SliderRange as NativeRangeSlider
import ui.component.fx.Upload as NativeUpload
import jdk.base.LocalDate
import jdk.base.LocalTime
import jdk.base.BigDecimal
import jdk.base.localDateOf
import jdk.base.localTimeOf
import jdk.base.bigDecimalNew
import std.filesystem.Path

class InputState {
  String text = "开始"
  Boolean checked = false
  String? selected = "一"
  String? treeSelected = "叶"
  List<String> selectedItems = ["一"]
  List<String> path = ["根", "叶"]
  LocalDate? date = localDateOf(arg0: 2026, arg1: 10, arg2: 2)!!
  LocalTime? time = localTimeOf(arg0: 13, arg1: 45)!!
  BigDecimal number = bigDecimalNew("1.25")!!
  Integer rating = 2
  Double amount = 30.0
  String color = "#1677ff"
  NumericRange range = NumericRange(start: 20.0, end: 70.0)
  Integer submissions = 0
}

class RuntimeOutcome { String? failure = null Boolean completed = false }

Void mountsEveryInputWidgetInARealJavaFxWindow() {
    var application = FxApplication("Input widgets")
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var state = InputState()
    var outcome = RuntimeOutcome()
    Binding<String> text = Binding<String>(read: () { state.text }, write: (String next) { state.text = next })
    Binding<Boolean> checked = Binding<Boolean>(read: () { state.checked }, write: (Boolean next) { state.checked = next })
    Binding<String?> selected = Binding<String?>(read: () { state.selected }, write: (String? next) { state.selected = next })
    Binding<String?> treeSelected = Binding<String?>(read: () { state.treeSelected }, write: (String? next) { state.treeSelected = next })
    Binding<List<String>> items = Binding<List<String>>(read: () { state.selectedItems }, write: (List<String> next) { state.selectedItems = next })
    Binding<List<String>> path = Binding<List<String>>(read: () { state.path }, write: (List<String> next) { state.path = next })
    Binding<LocalDate?> date = Binding<LocalDate?>(read: () { state.date }, write: (LocalDate? next) { state.date = next })
    Binding<LocalTime?> time = Binding<LocalTime?>(read: () { state.time }, write: (LocalTime? next) { state.time = next })
    Binding<BigDecimal> number = Binding<BigDecimal>(read: () { state.number }, write: (BigDecimal next) { state.number = next })
    Binding<Integer> rating = Binding<Integer>(read: () { state.rating }, write: (Integer next) { state.rating = next })
    Binding<Double> amount = Binding<Double>(read: () { state.amount }, write: (Double next) { state.amount = next })
    Binding<String> color = Binding<String>(read: () { state.color }, write: (String next) { state.color = next })
    Binding<NumericRange> range = Binding<NumericRange>(read: () { state.range }, write: (NumericRange next) { state.range = next })
    var field = FormField<String>(name: "title", state: FormFieldState<String>(initial: state.text), control: Input(placeholder: "标题", value: text),
      value: text, validator: (String next) { next != "" }, error: "请输入标题")
    List<Widget> widgets = [
      Input(placeholder: "标题", value: text),
      AutoComplete(placeholder: "查找", value: text, suggestions: ["开始", "继续"]),
      Cascader<String>(options: [CascaderOption(value: "根", label: "根", children: [
        CascaderOption(value: "叶", label: "叶")])], value: path),
      Checkbox(text: "同意", value: checked),
      ColorPicker(hex: color),
      DatePicker(value: date),
      Form(fields: [field], onSubmit: () { state.submissions = state.submissions + 1 }),
      InputNumber(value: number, scale: 2),
      Mentions(value: text, suggestions: ["林安"], placeholder: "提及"),
      Radio(text: "选项", value: checked),
      Rate(value: rating),
      Select<String>(options: ["一", "二"], value: selected),
      Slider(value: amount),
      Switch(text: "启用", value: checked),
      TimePicker(value: time),
      Transfer<String>(options: ["一", "二"], value: items),
      TreeSelect<String>(options: [TreeOption(value: "根", children: [TreeOption(value: "叶")])], value: treeSelected),
      Upload(uploader: (Path file, Function<Void(Double)> progress) { startTask<Unit?>(() { progress(1.0) null }) }),
      RangeSlider(value: range)
    ]
    application.run(build: () {
      try {
        for widget : widgets {
          renderer.render(widget)
          application.root(fxHandle(renderer.node()))
        }
        require(condition: widgets.size() == 19, message: "all 18 input widgets and range variant mounted")
        outcome.completed = true
      } catch Exception failure { outcome.failure = failure.message }
      finally { application.close() }
    }, dispose: renderer.close)
    require(condition: outcome.completed && outcome.failure == null,
      message: if outcome.failure == null { "input mounting did not complete" } else { outcome.failure!! })
}

Void nativeInputEditsWriteNormBindingsAndSurviveReconciliation() {
    var application = FxApplication("Input binding verification")
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var state = InputState()
    var outcome = RuntimeOutcome()
    Binding<String> text = Binding<String>(read: () { state.text }, write: (String next) { state.text = next })
    Binding<String?> selected = Binding<String?>(read: () { state.selected }, write: (String? next) { state.selected = next })
    Binding<LocalDate?> date = Binding<LocalDate?>(read: () { state.date }, write: (LocalDate? next) { state.date = next })
    Binding<NumericRange> range = Binding<NumericRange>(read: () { state.range }, write: (NumericRange next) { state.range = next })
    application.run(build: () {
      try {
        renderer.render(Input(placeholder: "名称", value: text).build())
        application.root(fxHandle(renderer.node()))
        switch fxHandle(renderer.node()).nativeNode() {
          case NativeInput control { control.setText("原生输入") }
          case _ { require(condition: false, message: "Input mounts its native TextField") }
        }
        require(condition: state.text == "原生输入", message: "native edit writes the Norm field")
        renderer.render(Input(placeholder: "新提示", value: text).build())
        switch fxHandle(renderer.node()).nativeNode() {
          case NativeInput control { require(condition: control.getText() == "原生输入", message: "reconciliation retains input") }
          case _ { require(condition: false, message: "Input remains a native TextField") }
        }
        renderer.render(Select<String>(options: ["一", "二"], value: selected).build())
        application.root(fxHandle(renderer.node()))
        switch fxHandle(renderer.node()).nativeNode() {
          case NativeSelect<String?> control { control.setValue("二") }
          case _ { require(condition: false, message: "Select mounts its native ComboBox") }
        }
        require(condition: state.selected == "二", message: "native Select writes a typed Norm value")
        renderer.render(Select<String>(options: ["二", "三"], value: selected).build())
        switch fxHandle(renderer.node()).nativeNode() {
          case NativeSelect<String?> control { require(condition: control.getValue() == "二", message: "option update retains selection") }
          case _ { require(condition: false, message: "Select remains native") }
        }
        renderer.render(DatePicker(value: date).build())
        application.root(fxHandle(renderer.node()))
        var changedDate = localDateOf(arg0: 2024, arg1: 2, arg2: 29)!!
        switch fxHandle(renderer.node()).nativeNode() {
          case NativeDatePicker control { control.setValue(changedDate) }
          case _ { require(condition: false, message: "DatePicker mounts its native editor") }
        }
        require(condition: state.date!!.toEpochDay() == changedDate.toEpochDay(), message: "native date edit preserves LocalDate")
        renderer.render(RangeSlider(value: range).build())
        application.root(fxHandle(renderer.node()))
        switch fxHandle(renderer.node()).nativeNode() {
          case NativeRangeSlider control { control.setRange(arg0: 35.0, arg1: 80.0) }
          case _ { require(condition: false, message: "RangeSlider mounts native control") }
        }
        require(condition: state.range.start == 35.0 && state.range.end == 80.0,
          message: "native range edit writes one typed Norm range")
        outcome.completed = true
      } catch Exception failure { outcome.failure = failure.message }
      finally { application.close() }
    }, dispose: renderer.close)
    require(condition: outcome.completed && outcome.failure == null,
      message: if outcome.failure == null { "native edits did not complete" } else { outcome.failure!! })
}

Void treeAndUploadRetainStateAcrossNativeUnmount() {
    var application = FxApplication("Tree and upload verification")
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var state = InputState()
    var outcome = RuntimeOutcome()
    Binding<String?> selected = Binding<String?>(read: () { state.selected }, write: (String? next) { state.selected = next })
    var tree = TreeSelect<String>(options: [TreeOption(value: "根", children: [TreeOption(value: "叶")])], value: selected)
    application.run(build: () {
      try {
        state.selected = "根"
        renderer.render(tree.build())
        application.root(fxHandle(renderer.node()))
        state.selected = "叶"
        renderer.render(tree.build())
        switch fxHandle(renderer.node()).nativeNode() {
          case NativeTreeSelect<String?> control {
            require(condition: control.getSelectedValue() == "叶", message: "tree selection follows Norm model")
          }
          case _ { require(condition: false, message: "TreeSelect mounts its native tree") }
        }
        renderer.render(Upload(uploader: (Path file, Function<Void(Double)> progress) {
          startTask<Unit?>(() { progress(1.0) null })
        }).build())
        application.root(fxHandle(renderer.node()))
        switch fxHandle(renderer.node()).nativeNode() {
          case NativeUpload control {
            control.addFile(Path(value: "ui/component/module.norm"))
            require(condition: control.getItems()!!.size() == 1, message: "native upload accepts a Norm Path")
          }
          case _ { require(condition: false, message: "Upload mounts native queue") }
        }
        renderer.render(Input(placeholder: "after upload", value: Binding<String>(read: () { state.text },
          write: (String next) { state.text = next })).build())
        application.root(fxHandle(renderer.node()))
        outcome.completed = true
      } catch Exception failure { outcome.failure = failure.message }
      finally { application.close() }
    }, dispose: renderer.close)
    require(condition: outcome.completed && outcome.failure == null,
      message: if outcome.failure == null { "tree and upload did not complete" } else { outcome.failure!! })
}

Void mountedFormValidatesSubmitsAndRestoresItsInitialValues() {
    var application = FxApplication("Form lifecycle verification")
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var state = InputState()
    var outcome = RuntimeOutcome()
    Binding<String> title = Binding<String>(read: () { state.text }, write: (String next) { state.text = next })
    var fieldState = FormFieldState<String>(initial: state.text)
    var field = FormField<String>(name: "title", state: fieldState, control: Input(placeholder: "任务标题", value: title),
      value: title, validator: (String next) { next != "" }, error: "请输入标题")
    var form = Form(fields: [field], onSubmit: () { state.submissions = state.submissions + 1 })
    application.run(build: () {
      try {
        renderer.render(form)
        application.root(fxHandle(renderer.node()))
        state.text = ""
        require(condition: !form.submit() && state.submissions == 0 && fieldState.invalid,
          message: "mounted form rejects invalid data without submitting")
        var redrawn = Form(fields: [FormField<String>(name: "title", state: fieldState,
          control: Input(placeholder: "新的任务标题", value: title), value: title,
          validator: (String next) { next != "" && next != "短" }, error: "请填写完整任务标题")],
          onSubmit: () { state.submissions = state.submissions + 1 })
        renderer.render(redrawn)
        require(condition: fieldState.invalid, message: "mounted form retains validation after a new description")
        state.text = "短"
        require(condition: !redrawn.submit() && state.submissions == 0,
          message: "mounted form applies the replacement validator")
        state.text = "真实任务"
        require(condition: redrawn.submit() && state.submissions == 1 && !fieldState.invalid,
          message: "mounted form validates and submits once")
        renderer.render(redrawn)
        redrawn.reset()
        renderer.render(redrawn)
        require(condition: state.text == "开始" && redrawn.validate(),
          message: "mounted form reset restores its initial typed value")
        outcome.completed = true
      } catch Exception failure { outcome.failure = failure.message }
      finally { application.close() }
    }, dispose: renderer.close)
    require(condition: outcome.completed && outcome.failure == null,
      message: if outcome.failure == null { "form did not complete" } else { outcome.failure!! })
}

@Test
Void verifiesInputWidgetsInOneJavaFxRuntime() {
  withFxRuntime(() {
    mountsEveryInputWidgetInARealJavaFxWindow()
    nativeInputEditsWriteNormBindingsAndSurviveReconciliation()
    treeAndUploadRetainStateAcrossNativeUnmount()
    mountedFormValidatesSubmitsAndRestoresItsInitialValues()
  })
}
