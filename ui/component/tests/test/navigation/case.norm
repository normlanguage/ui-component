package ui.component.test.navigation

import std.testing.Test
import ui.Widget
import ui.Text
import ui.Column
import ui.NodeKey
import ui.Binding
import ui.Renderer
import ui.JavaFxBackend
import ui.JavaFxScheduler
import ui.fxHandle
import ui.fx.FxApplication
import ui.fx.withFxRuntime
import ui.component.Button as ComponentButton
import ui.component.FloatButton
import ui.component.Icon
import ui.component.Typography
import ui.component.Divider
import ui.component.Flex
import ui.component.FlexItem
import ui.component.Grid
import ui.component.GridItem
import ui.component.GridBreakpoint
import ui.component.Layout
import ui.component.Masonry
import ui.component.Space
import ui.component.Splitter
import ui.component.Anchor
import ui.component.AnchorSection
import ui.component.Breadcrumb
import ui.component.BreadcrumbItem
import ui.component.Dropdown
import ui.component.Menu
import ui.component.MenuGroup
import ui.component.MenuItem
import ui.component.Pagination
import ui.component.Steps
import ui.component.Tabs
import ui.component.TabItem

class State {
  Integer page = 1
  Integer step = 0
  Integer tab = 0
  Integer clicked = 0
  Boolean completed = false
  Boolean closed = false
}

Widget preview(State state, String title) {
  Binding<Integer> page = Binding<Integer>(read: () { state.page }, write: (Integer next) { state.page = next })
  Binding<Integer> step = Binding<Integer>(read: () { state.step }, write: (Integer next) { state.step = next })
  Binding<Integer> tab = Binding<Integer>(read: () { state.tab }, write: (Integer next) { state.tab = next })
  Column([
    ComponentButton(text: title, action: () { state.clicked = state.clicked + 1 }),
    FloatButton(text: "+", content: Text("画布"), action: () { state.clicked = state.clicked + 1 }),
    Icon(literal: "mdi2s-star"),
    Typography(text: "标题", copyable: true),
    Divider(),
    Flex(items: [FlexItem(content: Text("左"), grow: 1.0), FlexItem(content: Text("右"))]),
    Grid(items: [GridItem(content: Text("第一项")), GridItem(content: Text("第二项"))],
      breakpoints: [GridBreakpoint(minimumWidth: 300.0, columns: 2)]),
    Layout(top: Text("页眉"), center: Text("正文"), bottom: Text("页脚")),
    Masonry(children: [Text("短"), Text("稍长内容")]),
    Space(children: [Text("操作一"), Text("操作二")]),
    Splitter(children: [Text("目录"), Text("内容")]),
    Anchor(sections: [AnchorSection(title: "简介", content: Text("简介内容")),
      AnchorSection(title: "用法", content: Text("用法内容"))]),
    Breadcrumb(items: [BreadcrumbItem(text: "首页", action: () { state.clicked = state.clicked + 1 }),
      BreadcrumbItem(text: "详情", action: () {})]),
    Dropdown(text: "更多", content: Text("更多操作")),
    Menu(groups: [MenuGroup(title: "文件", items: [MenuItem(text: "打开", action: () {})])]),
    Pagination(totalItems: 30, currentPage: page),
    Steps(titles: ["提交", "完成"], currentStep: step),
    Tabs(items: [TabItem(title: "信息", content: Text("信息页")),
      TabItem(title: "设置", content: Text("设置页"))], selected: tab, key: NodeKey.Named("tabs"))
  ])
}

@Test
Void mountsAllGeneralLayoutAndNavigationWidgetsInJavaFx() {
  withFxRuntime(() {
    var application = FxApplication("Component navigation verification", width: 1024.0, height: 768.0)
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var state = State()
    application.run(build: () {
      try {
        require(condition: application.column().nativeNode().getStyleClass()!!.contains("norm-column")
          && application.row().nativeNode().getStyleClass()!!.contains("norm-row")
          && application.component().nativeNode().getStyleClass()!!.contains("norm-component")
          && application.scroll().nativeNode().getStyleClass()!!.contains("norm-scroll"),
          message: "layout nodes expose stable theme style classes")
        renderer.render(preview(state, title: "开始"))
        application.root(fxHandle(renderer.node()))
        state.page = 2
        state.step = 1
        state.tab = 1
        renderer.render(preview(state, title: "继续"))
        require(condition: state.page == 2 && state.step == 1 && state.tab == 1,
          message: "navigation state survives native reconciliation")
        state.completed = true
      } finally { application.close() }
    }, dispose: () { renderer.close() state.closed = true })
    require(condition: state.completed && state.closed,
      message: "navigation window callback and renderer cleanup both completed")
  })
}
