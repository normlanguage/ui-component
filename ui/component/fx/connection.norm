package ui.component.fx

import theme.Theme
import theme.ThemeSource
import theme.Tone
import theme.Appearance
import theme.ControlState
import fx.graphics.Node
import std.io.Resource
import std.filesystem.Path

Void uploadFiles(Upload upload, List<Path> files) {
  for file : files { upload.addFile(file) }
}

App app(ThemeSource theme, Node content) {
  var root = appNew(content)
  connectTheme(provider: root, theme: theme)
  root
}

Void connectTheme(ConfigProvider provider, ThemeSource theme) {
  provider.publishTheme(themeCss(theme.current()))
  var bridge = ThemeBridge(source: theme)
  provider.connectTheme(arg0: (sink) { bridge.attach(sink!!) }, arg1: () { bridge.close() })
}

private class ThemeBridge implements Resource {
  ThemeSource source
  Resource? subscription = null
  Void attach(ThemeSink sink) {
    subscription = source.watch((Theme current) { sink.publish(themeCss(current)) })
  }
  Void close() {
    var current = subscription
    subscription = null
    current?.close()
  }
}

Button button(String text, Tone tone = Tone.Primary, Appearance appearance = Appearance.Filled, Boolean selected = false) {
  var control = buttonNew(text)
  styleButton(control: control, tone: tone, appearance: appearance, selected: selected)
  control
}

Void styleButton(Button control, Tone tone = Tone.Primary, Appearance appearance = Appearance.Filled, Boolean selected = false) {
  var prefix = "-norm-" + toneName(tone) + "-" + appearanceName(appearance)
  if selected { prefix = prefix + "-selected" }
  var css = ""
  for state : ["normal", "hovered", "pressed", "disabled"] {
    for part : ["background", "foreground", "border"] {
      css = css + "-norm-button-" + state + "-" + part + ": " + prefix + "-" + state + "-" + part + ";"
    }
  }
  control.setStyle(css)
}

private String toneName(Tone tone) {
  switch tone {
    case Neutral { break "neutral" }
    case Primary { break "primary" }
    case Secondary { break "secondary" }
    case Success { break "success" }
    case Warning { break "warning" }
    case Danger { break "danger" }
    case Info { break "info" }
  }
}

private String appearanceName(Appearance appearance) {
  switch appearance {
    case Filled { break "filled" }
    case Soft { break "soft" }
    case Outlined { break "outlined" }
    case Plain { break "plain" }
  }
}

String themeCss(Theme theme) {
  var css = "-norm-canvas: " + theme.canvas.background.hex() + ";"
  css = css + "-norm-text: " + theme.canvas.foreground.hex() + ";"
  css = css + "-norm-surface: " + theme.surface.background.hex() + ";"
  css = css + "-norm-surface-raised: " + theme.surfaceRaised.background.hex() + ";"
  css = css + "-norm-divider: " + theme.divider.hex() + ";"
  css = css + "-norm-muted: " + theme.textMuted.hex() + ";"
  css = css + "-norm-outline: " + theme.outline.hex() + ";"
  css = css + "-norm-focus: " + theme.control(tone: Tone.Primary).focusRing.hex() + ";"
  css = css + "-norm-scrim: " + theme.scrim.hex() + ";"
  var tones = [Tone.Neutral, Tone.Primary, Tone.Secondary, Tone.Success, Tone.Warning, Tone.Danger, Tone.Info]
  var appearances = [Appearance.Filled, Appearance.Soft, Appearance.Outlined, Appearance.Plain]
  for tone : tones {
    for appearance : appearances {
      for selected : [false, true] {
      var palette = theme.control(tone, appearance, selected)
      var prefix = "-norm-" + toneName(tone) + "-" + appearanceName(appearance)
      if selected { prefix = prefix + "-selected" }
      css = css + stateCss(prefix: prefix + "-normal", state: palette.normal)
      css = css + stateCss(prefix: prefix + "-hovered", state: palette.hovered)
      css = css + stateCss(prefix: prefix + "-pressed", state: palette.pressed)
      css = css + stateCss(prefix: prefix + "-disabled", state: palette.disabled)
      }
    }
  }
  css
}

private String stateCss(String prefix, ControlState state) {
  prefix + "-background: " + state.background.hex() + ";" + prefix + "-foreground: " + state.foreground.hex() + ";" + prefix + "-border: " + state.border.hex() + ";"
}

Void styleSurface(Node control, Tone tone = Tone.Neutral, Appearance appearance = Appearance.Soft) {
  var prefix = "-norm-" + toneName(tone) + "-" + appearanceName(appearance)
  utilStyle(arg0: control, arg1: "-norm-surface-background: " + prefix + "-normal-background;"
    + "-norm-surface-foreground: " + prefix + "-normal-foreground;"
    + "-norm-surface-border: " + prefix + "-normal-border;"
    + "-norm-surface-hover: " + prefix + "-hovered-background;")
}
