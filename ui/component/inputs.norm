private class ValueHost<C, T> {
  C control
  ValueLink<T?> value
}

private class SelectionHost<C, T> {
  C control
  SelectionLink<T?> value
}

value Input implements Widget {
  String placeholder
  Binding<String> value
  NodeKey? key = null
  Boolean enabled = true

  Widget build() {
    nativeComponent<ValueHost<InputControl, String>>(kind: "ui.component.Input",
      create: () {
        var control = inputNew()
        ValueHost<InputControl, String>(control: control, value: inputAdapterInputValue(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        host.control.setPromptText(placeholder)
        host.value.update(arg0: value.value, arg1: scope.bind((String? next) { if next != null { value.value = next } }))
      }, close: (host) { host.value.close() }, key: key, enabled: enabled)
  }
}

