value InputNumber implements Widget {
  Binding<BigDecimal> value
  Integer? scale = null
  NodeKey? key = null
  Boolean enabled = true

  Widget build() {
    var identity = "ui.component.InputNumber"
    var digits = scale
    if digits != null { identity = identity + "." + digits!!.toString() }
    nativeComponent<SelectionHost<InputNumberControl, BigDecimal>>(kind: identity,
      create: () {
        var control = inputNumberNew()
        if digits != null { control.setScale(digits!!) }
        SelectionHost<InputNumberControl, BigDecimal>(control: control, value: inputAdapterNumberValue(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        host.value.update(arg0: value.value, arg1: scope.bind((BigDecimal? next) { if next != null { value.value = next } }))
      }, close: (host) { host.value.close() }, key: key, enabled: enabled)
  }
}

