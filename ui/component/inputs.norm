value CascaderOption<T> {
  T value
  String label
  List<CascaderOption<T>> children = []
}

private List<CascaderItem<T?>> nativeCascaderOptions<T>(List<CascaderOption<T>> options) {
  [for (option : options) cascaderItem<T>(value: option.value, label: option.label,
    children: nativeCascaderOptions<T>(option.children))]
}

private class CascaderHost<T> {
  CascaderControl<T?> control
  SelectionLink<MutableList<T?>?> path
}

value Cascader<T> implements Widget {
  List<CascaderOption<T>> options
  Binding<List<T>> value
  NodeKey? key = null
  Boolean enabled = true

  Widget build() {
    nativeComponent<CascaderHost<T>>(kind: "ui.component.Cascader",
      create: () {
        var control = cascader<T>(items: nativeCascaderOptions(options))
        CascaderHost<T>(control: control, path: inputAdapterCascaderPath(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        updateCascaderOptions(control: host.control, options: nativeCascaderOptions(options))
        host.path.update(arg0: hostItems(value.value), arg1: scope.bind((MutableList<T?>? next) {
          List<T> selected = []
          if next != null { for item : next { if item != null { selected.add(item) } } }
          value.value = selected
        }))
      }, close: (host) { host.path.close() }, key: key, enabled: enabled)
  }
}

value TreeOption<T> {
  T value
  List<TreeOption<T>> children = []
}

private List<CascaderItem<T?>> nativeTreeOptions<T>(List<TreeOption<T>> options) {
  [for (option : options) cascaderItem<T>(value: option.value, label: "",
    children: nativeTreeOptions<T>(option.children))]
}

