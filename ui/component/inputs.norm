private class UploadHost {
  UploadControl control
  List<Path> added = []
}

value Upload implements Widget {
  Function<Task<Unit?>(Path, Function<Void(Double)>)> uploader
  List<Path> files = []
  NodeKey? key = null
  Boolean enabled = true

  Widget build() {
    nativeComponent<UploadHost>(kind: "ui.component.Upload",
      create: () { UploadHost(control: uploadNew()) }, node: (host) { host.control },
      update: (host, scope) {
        inputAdapterUploadTaskHandler(arg0: host.control, arg1: (Path? file, InputAdapterProgress? progress) {
          if file == null || progress == null { throw Exception(message: "Missing upload file or progress reporter") }
          scope.within<Task<Unit?>>(action: () {
            uploader(file, (Double amount) { progress.report(amount) })
          })
        })
        for file : files {
          var alreadyAdded = false
          for existing : host.added { if existing == file { alreadyAdded = true } }
          if !alreadyAdded {
            host.control.addFile(file)
            host.added.add(file)
          }
        }
      }, close: (host) { host.control.close() }, key: key, enabled: enabled)
  }
}

