value DateRange {
  LocalDate? start
  LocalDate? end
}

value DateRangePicker implements Widget {
  Binding<DateRange> value
  NodeKey? key = null
  Boolean enabled = true

  Widget build() {
    nativeComponent<ValueHost<DatePickerRangeControl, NativeDateRange>>(kind: "ui.component.DatePicker.Range",
      create: () {
        var control = datePickerRangeNew()
        ValueHost<DatePickerRangeControl, NativeDateRange>(control: control, value: inputAdapterDateRangeValue(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        var current = value.value
        host.value.update(arg0: dateRangeNew(arg0: current.start, arg1: current.end),
          arg1: scope.bind((NativeDateRange? next) {
            if next != null { value.value = DateRange(start: next.start(), end: next.end()) }
          }))
      }, close: (host) { host.value.close() }, key: key, enabled: enabled)
  }
}

value NumericRange {
  Double start
  Double end
}

private class RangeSliderHost {
  SliderRangeControl control
  SelectionLink<MutableList<Double?>?> value
}

value RangeSlider implements Widget {
  Binding<NumericRange> value
  Double minimum = 0.0
  Double maximum = 100.0
  NodeKey? key = null
  Boolean enabled = true

  Widget build() {
    nativeComponent<RangeSliderHost>(kind: "ui.component.Slider.Range",
      create: () {
        var current = value.value
        var control = sliderRangeNew(arg0: minimum, arg1: maximum, arg2: current.start, arg3: current.end)
        RangeSliderHost(control: control, value: inputAdapterSliderRangeValue(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        var current = value.value
        inputAdapterSliderRangeBounds(arg0: host.control, arg1: minimum, arg2: maximum)
        var changed = scope.bind((NumericRange next) { value.value = next })
        host.value.update(arg0: hostItems([current.start, current.end]), arg1: (MutableList<Double?>? next) {
          if next != null && next.size() == 2 && next.get(0) != null && next.get(1) != null {
            changed(NumericRange(start: next.get(0)!!, end: next.get(1)!!))
          }
        })
      }, close: (host) { host.value.close() }, key: key, enabled: enabled)
  }
}

interface FormEntry extends Widget {
  String name()
  Boolean validate()
  Void reset()
}

class FormFieldState<T> {
  T initial
  Boolean invalid = false

  FormFieldState(T initial) { this.initial = initial }
}

private class FormFieldView<T> implements Widget {
  FormFieldState<T> state
  Widget control
  String error
  private Boolean invalid = false
  private FormFieldState<T>? observed = null
  private Resource? subscription = null

  FormFieldView(FormFieldState<T> state, Widget control, String error) {
    this.state = state
    this.control = control
    this.error = error
  }

  Widget build() {
    if observed != state {
      subscription?.close()
      observed = state
      invalid = state.invalid
      subscription = observeFields<FormFieldState<T>>(target: state,
        read: (Integer field) {}, changed: (Integer field) { invalid = state.invalid })
    }
    if invalid { return UiColumn(children: [control, UiText(text: error, role: WidgetRole.Destructive)]) }
    control
  }

  Void dispose() { subscription?.close() }
}

value FormField<T> implements FormEntry {
  String name
  FormFieldState<T> state
  Widget control
  Binding<T> value
  Function<Boolean(T)> validator
  String error

  FormField(String name, FormFieldState<T> state, Widget control, Binding<T> value,
    Function<Boolean(T)> validator, String error) {
    this.name = name
    this.state = state
    this.control = control
    this.value = value
    this.validator = validator
    this.error = error
  }

  String name() { name }
  Boolean validate() {
    state.invalid = !validator(value.value)
    !state.invalid
  }
  Void reset() {
    value.value = state.initial
    state.invalid = false
  }
  Widget build() { FormFieldView<T>(state: state, control: control, error: error) }
}

value Form implements Widget {
  List<FormEntry> fields
  Function<Void()> onSubmit
  String submitText
  String resetText

  Form(List<FormEntry> fields, Function<Void()> onSubmit, String submitText = "提交", String resetText = "重置") {
    this.fields = fields
    this.onSubmit = onSubmit
    this.submitText = submitText
    this.resetText = resetText
  }

  Boolean validate() {
    var valid = true
    for field : fields { if !field.validate() { valid = false } }
    valid
  }
  Boolean submit() {
    if !this.validate() { return false }
    onSubmit()
    true
  }
  Void reset() { for field : fields { field.reset() } }
  Widget build() {
    List<Widget> content = []
    for field : fields { content.add(field) }
    content.add(UiRow(children: [
      Button(text: submitText, action: () { this.submit() return }),
      Button(text: resetText, action: () { this.reset() })
    ]))
    UiColumn(children: content)
  }
}

