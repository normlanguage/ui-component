    nativeComponent<BadgeControl>(kind: "ui.desktop.kit.Badge",
      create: () { displayAdapterBadge()!! }, node: (control) { control },
      update: (control, scope) { control.setCount(count) }, children: [content],
      arrange: (control, nodes) { displayAdapterBadgeContent(arg0: control, arg1: nodes[0]) },
      close: (control) { utilCloseNode(control) }, key: key)
  }
}

private class CalendarHost {
  CalendarControl control
  ValueLink<LocalDate> selected
  ValueLink<YearMonth> month
}

value Calendar implements Widget {
  Binding<LocalDate?> selected
  Binding<YearMonth>? displayedMonth = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<CalendarHost>(kind: "ui.desktop.kit.Calendar",
      create: () {
        var control = calendarNew()
        CalendarHost(control: control, selected: displayAdapterCalendarValue(control)!!, month: displayAdapterCalendarMonth(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        var selectedChanged = scope.bind((LocalDate? next) { selected.value = next })
        host.selected.update(arg0: selected.value, arg1: selectedChanged)
        var currentMonth = displayedMonth
        if currentMonth != null {
          var monthChanged = scope.bind((YearMonth? next) { currentMonth.value = next!! })
          host.month.update(arg0: currentMonth.value, arg1: monthChanged)
        } else { host.month.unbind() }
      }, close: (host) {
        host.selected.close()
        host.month.close()
        host.control.close()
      }, key: key)
  }
}

value Card implements Widget {
  Widget content
  String title = ""
  Widget? header = null
  Tone tone = Tone.Neutral
  Appearance appearance = Appearance.Plain
  Widget? bottom = null
  NodeKey? key = null

  Double sectionGap = 0.0

  Widget build() {
    var footer = bottom
    var heading = header
    Widget body = content
    if sectionGap > 0.0 && (heading != null || footer != null) {
      body = Box(content: content, size: SizeConstraints(width: Dimension.Fill, height: Dimension.Fill),
        padding: Insets(top: if heading != null { sectionGap } else { 0.0 },
          bottom: if footer != null { sectionGap } else { 0.0 }))
    }
    List<Widget> children = [body]
    if footer != null { children.add(footer) }
    if heading != null { children.add(heading) }
    nativeComponent<CardControl>(kind: "ui.desktop.kit.Card",
      create: () { displayAdapterCard(title)!! }, node: (control) { control },
      update: (control, scope) {
        control.setTitle(title)
        styleSurface(control: control, tone: tone, appearance: appearance)
      }, children: children,
      arrange: (control, nodes) {
        displayAdapterCardSlots(arg0: control, arg1: nodes[0], arg2: if footer != null { nodes[1] } else { null })
        control.setHeader(if heading != null { nodes[if footer != null { 2 } else { 1 }] } else { null })
      },
      close: (control) { utilCloseNode(control) }, key: key)
  }
}

value Carousel implements Widget {
  List<Widget> slides
  Integer index = 0
  Boolean autoPlay = false
  NodeKey? key = null

  Widget build() {
    nativeComponent<CarouselControl>(kind: "ui.desktop.kit.Carousel",
      create: () { carouselNew() }, node: (control) { control },
      update: (control, scope) {
        control.setAutoPlay(autoPlay)
      }, children: slides,
      arrange: (control, nodes) {
        displayAdapterCarouselSlides(arg0: control, arg1: hostItems(nodes))
        if nodes.size() > index { control.setIndex(index) }
      },
      close: (control) { control.close() }, key: key)
  }
}

private class CollapseHost {
  CollapseControl control
  ValueLink<Boolean> expanded
}

value Collapse implements Widget {
  String title
  Widget content
  Binding<Boolean> expanded
  NodeKey? key = null

  Widget build() {
    nativeComponent<CollapseHost>(kind: "ui.desktop.kit.Collapse",
      create: () {
        var control = displayAdapterCollapse(title)
        CollapseHost(control: control!!, expanded: displayAdapterCollapseExpanded(control!!)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        host.control.setText(title)
        var changed = scope.bind((Boolean? next) { expanded.value = next!! })
        host.expanded.update(arg0: expanded.value, arg1: changed)
      }, children: [content],
      arrange: (host, nodes) { displayAdapterCollapseContent(arg0: host.control, arg1: nodes[0]) },
      close: (host) { host.expanded.close() host.control.close() }, key: key)
  }
}

