private class TreeHost<T> {
  TreeControl<T?> control
  TreeSelectionLink<T?> selected
  TreeCheckLink<T?> checked
}

value Tree<T> implements Widget {
  T root
  Function<List<T>(T)> children
  Binding<T?>? selected = null
  Boolean checkable = false
  Binding<List<T>>? checked = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<TreeHost<T>>(kind: "ui.desktop.kit.Tree",
      create: () {
        var control = treeNew<T?>(root)
        TreeHost<T>(control: control, selected: displayAdapterTreeSelected(control)!!,
          checked: treeCheckLinkNew<T?>(control))
      }, node: (host) { host.control },
      update: (host, scope) {
        displayAdapterTreeChildren(arg0: host.control, arg1: (T? value) { hostNullableItems(children(value!!)) })
        host.control.setCheckable(checkable)
        var selection = selected
        if selection != null {
          var changed = scope.bind((T? next) { selection.value = next })
          host.selected.update(arg0: selection.value, arg1: changed)
        } else { host.selected.unbind() }
        var checks = checked
        if checks != null {
          var changed = scope.bind<JavaList<T?>?>((JavaList<T?>? next) {
            checks.value = selectionItems(next)
          })
          host.checked.update(arg0: hostNullableItems(checks.value), arg1: changed)
        } else { host.checked.unbind() }
      }, close: (host) { host.selected.close() host.checked.close() utilCloseNode(host.control) }, key: key)
  }
}
