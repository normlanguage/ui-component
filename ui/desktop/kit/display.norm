private class ListHost<T> {
  ListControl<T?> control
  SelectionLink<T?> selected
}

value ListView<T> implements Widget {
  List<T> items
  Binding<T?>? selected = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<ListHost<T>>(kind: "ui.desktop.kit.ListView",
      create: () {
        var control = listViewNew<T?>()
        ListHost<T>(control: control, selected: displayAdapterSelected(control)!!)
      }, node: (host) { host.control },
      update: (host, scope) {
        displayAdapterItems(arg0: host.control, arg1: hostNullableItems(items))
        var selection = selected
        if selection != null {
          var changed = scope.bind((T? next) { selection.value = next })
          host.selected.update(arg0: selection.value, arg1: changed)
        } else { host.selected.unbind() }
      }, close: (host) { host.selected.close() utilCloseNode(host.control) }, key: key)
  }
}

private class ListyHost<T> {
  ListyControl<T?> control
  SelectionLink<T?> selected
  State<List<T>> visible
}

value Listy<T> implements Widget {
  List<T> items
  Function<ItemKey(T)> identity
  Function<Widget(T)> row
  Double rowHeight = 32.0
  Binding<T?>? selected = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<ListyHost<T>>(kind: "ui.desktop.kit.Listy",
      create: () {
        var control = listyNew<T?>()
        ListyHost<T>(control: control, selected: displayAdapterSelected(control)!!,
          visible: currentContext<ViewScope>()!!.createState<List<T>>([]))
      }, node: (host) { host.control },
      update: (host, scope) {
        var visible = host.visible
        host.control.rows(scope.bind<JavaList<T?>?>((JavaList<T?>? next) { visible.value = selectionItems(next) }))
        host.control.setRowHeight(rowHeight)
        displayAdapterItems(arg0: host.control, arg1: hostNullableItems(items))
        var selection = selected
        if selection != null {
          var changed = scope.bind((T? next) { selection.value = next })
          host.selected.update(arg0: selection.value, arg1: changed)
        } else { host.selected.unbind() }
      }, childrenBuilder: (host) { ForEach<T>(items: host.visible.value, identity: identity, child: row).widgets() },
      arrange: (host, nodes) { host.control.rowNodes(hostItems(nodes)) },
      close: (host) { host.selected.close() host.control.close() utilCloseNode(host.control) }, key: key)
  }
}

