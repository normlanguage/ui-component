value Avatar implements Widget {
  String text
  String? source = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<AvatarControl>(kind: "ui.desktop.kit.Avatar",
      create: () { avatarNew(text) }, node: (control) { control },
      update: (control, scope) {
        control.setText(text)
        displayAdapterAvatarSource(arg0: control, arg1: source)
      }, close: (control) { utilCloseNode(control) }, key: key)
  }
}

value Badge implements Widget {
