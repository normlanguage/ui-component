value TableColumn<T> {
  String id
  String heading
  Function<String(T)> display = (T row) { "" }
  Function<Integer(T, T)>? compare = null
  Function<Widget(T)>? cell = null
}

value TableSort {
  String columnId
  Boolean descending = false
}

private value TableCellIdentity implements ItemKey { String columnId ItemKey row }

private class TableHost<T> {
  TableControl<T?> control
  SelectionLink<T?> selected
  TableSortLink<T?> sorting
  State<List<TableCellSlot<T?>>> slots
}

value Table<T> implements Widget {
  List<T> rows
  Function<ItemKey(T)> identity
  List<TableColumn<T>> columns
  Binding<T?>? selected = null
  Binding<TableSort?>? sort = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<TableHost<T>>(kind: "ui.desktop.kit.Table",
      create: () {
        var control = tableNew<T?>()
        TableHost<T>(control: control, selected: displayAdapterTableSelected(control)!!,
          sorting: tableSortLinkNew<T?>(control),
          slots: currentContext<ViewScope>()!!.createState<List<TableCellSlot<T?>>>([]))
      }, node: (host) { host.control },
      update: (host, scope) {
        var selection = selected
        T? requestedSelection = null
        if selection != null {
          var currentSelection = selection.value
          if currentSelection != null {
            var rowIdentity = identity(currentSelection)
            for row : rows {
              if identity(row) == rowIdentity { requestedSelection = row break }
            }
          }
        }
        host.selected.unbind()
        displayAdapterRows(arg0: host.control, arg1: hostNullableItems(rows))
        var visible = host.slots
        host.control.cellSlots(scope.bind<JavaList<TableCellSlot<T?>>?>((JavaList<TableCellSlot<T?>>? next) {
          List<TableCellSlot<T?>> items = []
          if next != null {
            var iterator = next.iterator()!!
            for iterator.hasNext() { items.add(iterator.next()!!) }
          }
          visible.value = items
        }))
        host.sorting.columns(hostItems([for (column : columns)
          tableColumnSpecNew<T?>(arg0: column.id, arg1: column.heading,
            arg2: (T? row) { column.display(row!!) },
            arg3: if column.compare == null { null } else { (T? left, T? right) { column.compare!!(left!!, right!!) } },
            arg4: column.cell != null)]))
        if selection != null {
          if selection.value != requestedSelection { selection.value = requestedSelection }
          var changed = scope.bind((T? next) { selection.value = next })
          host.selected.update(arg0: requestedSelection, arg1: changed)
        } else { host.selected.unbind() }
        var order = sort
        if order != null {
          var requested = order.value
          host.sorting.update(arg0: if requested == null { null } else {
              tableSortStateNew(arg0: requested.columnId, arg1: requested.descending)
            }, arg1: scope.bind((NativeTableSort? next) {
              order.value = if next == null { null } else {
                TableSort(columnId: next.columnId()!!, descending: next.descending())
              }
            }))
        } else { host.sorting.unbind() }
      }, childrenBuilder: (host) {
        List<Widget> widgets = []
        var visible = host.slots
          for slot : visible.value {
            for column : columns {
              if column.id == slot.columnId()!! {
                var factory = column.cell
                if factory != null {
                  var view = describe(factory(slot.row()!!))
                  widgets.add(View(key: NodeKey.Item(TableCellIdentity(columnId: slot.columnId()!!, row: identity(slot.row()!!))),
                    content: view.content, role: view.role, enabled: view.enabled, reference: view.reference))
                }
              }
            }
          }
        widgets
      }, arrange: (host, nodes) { host.control.cellNodes(hostItems(nodes)) },
      close: (host) { host.selected.close() host.sorting.close() host.control.close() }, key: key)
  }
}

value Tag implements Widget {
  String text
  Tone tone = Tone.Neutral
  Appearance appearance = Appearance.Soft
  Boolean closable = false
  Function<Void()>? onClose = null
  NodeKey? key = null

  Widget build() {
    nativeComponent<TagControl>(kind: "ui.desktop.kit.Tag",
      create: () { tagNew(text) }, node: (control) { control },
      update: (control, scope) {
        control.setText(text)
        control.setClosable(closable)
        styleSurface(control: control, tone: tone, appearance: appearance)
        var action = onClose
        displayAdapterTagOnClose(arg0: control, arg1: if action != null { scope.bind(action) } else { null })
      }, close: (control) { utilCloseNode(control) }, key: key)
  }
}

