class Cell<T> { T value }

Widget preview(Cell<LocalDate?> date, Cell<Boolean> expanded, Cell<String?> selected) {
  Binding<LocalDate?> dateValue = Binding<LocalDate?>(read: () { date.value }, write: (LocalDate? next) { date.value = next })
  Binding<Boolean> isExpanded = Binding<Boolean>(read: () { expanded.value }, write: (Boolean next) { expanded.value = next })
  Binding<String?> selection = Binding<String?>(read: () { selected.value }, write: (String? next) { selected.value = next })
  Vertical([
    Avatar(text: "AL"),
    Badge(content: Text("任务"), count: 3),
    Calendar(selected: dateValue),
    Card(title: "项目", content: Text("本周进度"), bottom: Text("更新于今天")),
    Carousel(slides: [Text("第一张"), Text("第二张")]),
    Collapse(title: "详情", content: Text("完整内容"), expanded: isExpanded),
    Descriptions(items: [Description(label: "状态", content: Text("运行中"))]),
    Empty(description: "暂无数据"),
    Image(source: ""),
    ListView<String>(items: ["甲", "乙"], selected: selection),
    Listy<String>(identity: (String value) { ValueKey<String>(value) }, row: (String value) { Text(value) }, items: ["一", "二"], selected: selection),
    QRCode(text: "https://normlanguage.org"),
    Segmented<String>(items: ["日", "周", "月"], selected: selection),
    Statistic(title: "完成数", value: 42),
    Table<String>(identity: (String row) { ValueKey(value: row) }, rows: ["Alpha", "Beta"], columns: [DataColumn<String>(id: "name", heading: "名称", display: (String row) { row })]),
    Tag(text: "已发布", closable: true),
    Timeline(entries: [TimelineEntry(time: "09:30", content: Text("创建项目"))]),
    Tree<String>(root: "根", children: (String item) { if item == "根" { ["分支"] } else { [] } }, selected: selection)
  ], gap: 12.0)
}

Void rendersAllDisplayWidgetsAndRetainsTypedState() {
  withFxRuntime(() {
    var application = FxApplication("Display widgets")
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var date = Cell<LocalDate?>(value: localDateOf(arg0: 2026, arg1: 10, arg2: 2)!!)
    var expanded = Cell<Boolean>(value: false)
    var selected = Cell<String?>(value: "甲")
    var completed = Cell<Boolean>(value: false)
    var closed = Cell<Boolean>(value: false)
    application.run(build: () {
      try {
        renderer.render(preview(date, expanded, selected))
        application.root(fxHandle(renderer.node()))
        expanded.value = true
        selected.value = "乙"
        renderer.render(preview(date, expanded, selected))
        require(condition: date.value != null && expanded.value && selected.value == "乙",
          message: "display bindings survive native reconciliation")
        completed.value = true
      } finally { application.close() }
    }, dispose: () { renderer.close() closed.value = true })
    require(condition: completed.value && closed.value,
      message: "display window callback and renderer cleanup both completed")
  })
}


class VirtualRowsLifetime { Integer initialized = 0 Integer disposed = 0 }

class VirtualRow implements Widget {
  String value
  VirtualRowsLifetime lifetime
  Void init() { lifetime.initialized = lifetime.initialized + 1 }
  Widget build() { Text(value) }
  Void dispose() { lifetime.disposed = lifetime.disposed + 1 }
}

Void rendersOnlyVisibleListyWidgetsAndDisposesTheirScopes() {
  withFxRuntime(() {
    var application = FxApplication("Virtual widget rows", width: 360.0, height: 240.0)
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var lifetime = VirtualRowsLifetime()
    List<String> items = []
    var index = 0
    for index < 10000 { items.add("row-" + index.toString()) index = index + 1 }
    application.run(build: () {
      renderer.render(Listy<String>(items: items,
        identity: (String item) { ValueKey<String>(item) },
        row: (String item) { VirtualRow(value: item, lifetime: lifetime) }))
      application.root(fxHandle(renderer.node()))
      application.later(() {
        application.later(() {
          require(condition: lifetime.initialized > 0 && lifetime.initialized < 30,
            message: "virtual list mounts only a bounded visible window of Widgets")
          renderer.render(Listy<String>(items: [],
            identity: (String item) { ValueKey<String>(item) },
            row: (String item) { VirtualRow(value: item, lifetime: lifetime) }))
          application.later(() {
            require(condition: lifetime.disposed == lifetime.initialized,
              message: "removing virtual rows disposes every mounted Widget scope")
            application.close()
          })
        })
      })
    }, dispose: renderer.close)
    require(condition: lifetime.disposed == lifetime.initialized,
      message: "closing a virtual list retains no row scope")
  })
}

Void virtualTableCellsUseTheSharedWidgetLifecycle() {
  withFxRuntime(() {
    var application = FxApplication("Virtual table cells", width: 520.0, height: 280.0)
    var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
    var lifetime = VirtualRowsLifetime()
    List<String> rows = []
    var index = 0
    for index < 10000 { rows.add("order-" + index.toString()) index = index + 1 }
    application.run(build: () {
      renderer.render(Table<String>(rows: rows, identity: (String row) { ValueKey<String>(row) },
        columns: [DataColumn<String>(id: "order", heading: "Order", cell: (String row) {
          VirtualRow(value: row, lifetime: lifetime)
        })]))
      application.root(fxHandle(renderer.node()))
      application.later(() {
        application.later(() {
          require(condition: lifetime.initialized > 0 && lifetime.initialized < 30,
            message: "table creates only visible Widget cells through the shared renderer")
          renderer.render(Table<String>(rows: [], identity: (String row) { ValueKey<String>(row) },
            columns: [DataColumn<String>(id: "order", heading: "Order", cell: (String row) {
              VirtualRow(value: row, lifetime: lifetime)
            })]))
          application.later(() {
            require(condition: lifetime.disposed == lifetime.initialized,
              message: "removing table rows closes every virtual cell Widget scope")
            application.close()
          })
        })
      })
    }, dispose: renderer.close)
    require(condition: lifetime.disposed == lifetime.initialized, message: "table close retains no Widget scope")
  })
}

@Test
Void verifiesDisplayWidgetsInOneJavaFxRuntime() {
  withFxRuntime(() {
    rendersAllDisplayWidgetsAndRetainsTypedState()
    preservesSelectedIdentityWhenRowDataIsReplaced()
    rendersOnlyVisibleListyWidgetsAndDisposesTheirScopes()
    virtualTableCellsUseTheSharedWidgetLifecycle()
  })
}

Void preservesSelectedIdentityWhenRowDataIsReplaced() {
  var application = FxApplication("Table row identity")
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
  var chosen = Cell<String?>(value: "original")
  var selection = Binding<String?>(read: () { chosen.value }, write: (String? next) { chosen.value = next })
  application.run(build: () {
    try {
      renderer.render(Table<String>(rows: ["original"], identity: (String row) { ValueKey<String>("same-order") },
        columns: [DataColumn<String>(id: "name", heading: "Name", display: (String row) { row })], selected: selection))
      application.root(fxHandle(renderer.node()))
      renderer.render(Table<String>(rows: ["updated"], identity: (String row) { ValueKey<String>("same-order") },
        columns: [DataColumn<String>(id: "name", heading: "Name", display: (String row) { row })], selected: selection))
    } finally { application.close() }
  }, dispose: renderer.close)
  require(condition: chosen.value == "updated", message: "replacing a selected row with the same identity projects selection onto its current data")
}

private class SlotProbe implements RenderNode {
  Void update(View view) {}
  Void children(List<RenderNode> children) {}
  Void close() {}
}

@Test
Void customCardSectionsOnlyReserveSpaceForPresentSlots() {
  var body = Text("Body")
  for footer : [false, true] {
    var card = Card(content: body, header: Text("Header"),
      bottom: if footer { Text("Actions") } else { null }, sectionGap: 12.0)
    switch describe(card.build()).content {
      case Native(NativeView node) {
        var sections = node.children(SlotProbe())
        switch sections[0].content {
          case Native(NativeView layout) {
            switch layout {
              case LayoutView box {
                switch box.specification {
                  case Box(_, Insets insets) {
                    require(condition: insets.top == 12.0 && insets.bottom == (if footer { 12.0 } else { 0.0 }), message: "only present sections get spacing")
                  }
                  case _ { require(condition: false, message: "expected a padded card body") }
                }
              }
              case _ { require(condition: false, message: "expected a layout") }
            }
          }
          case _ { require(condition: false, message: "expected a native card body") }
        }
      }
      case _ { require(condition: false, message: "expected a card") }
    }
  }
}
