import ui.Renderer
import ui.Widget
import ui.NodeKey
import ui.desktop.JavaFxBackend
import ui.desktop.JavaFxScheduler
import ui.desktop.fxHandle
import ui.desktop.FxApplication
import ui.desktop.nativeComponent
import ui.desktop.native.Button
import ui.desktop.native.buttonNew
import ui.ThemeProvider
import ui.theme.ThemeManager
import ui.theme.ThemeDefinition
import ui.theme.Color
import std.core.Exception

Module module() {
  module(dependencies: [dependency(repository: "github", name: "ui", version: 11), dependency(repository: "github", name: "ui.desktop", version: 10), dependency(repository: "github", name: "ui.theme", version: 5)])
}

class Verification { Boolean completed = false String? failure = null }

class NativeCounter implements Widget {
  Integer count = 0
  Widget build() {
    nativeComponent<Button>(kind: "sample.NativeCounter", key: NodeKey.Named("native-counter"),
      create: buttonNew, node: (control) { control },
      update: (control, scope) {
        control.setText("Count " + count.toString())
        var clicked = scope.bind(() { count = count + 1 })
        control.setOnAction((event) { clicked() })
      }, close: (control) { control.setOnAction(null) })
  }
}

Void main() {
  var application = FxApplication("Native extension probe")
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
  var theme = ThemeManager(definition: ThemeDefinition(primary: Color(hex: "#2563EB")))
  var counter = NativeCounter()
  var content = ThemeProvider(source: theme, child: counter)
  var verification = Verification()
  application.run(build: () {
    renderer.render(content)
    application.root(fxHandle(renderer.node()))
    application.later(() {
      try {
        switch application.scene().lookup("#native-counter") {
          case Button control {
            control.fire()
            renderer.render(content)
            require(condition: counter.count == 1 && control.getText() == "Count 1", message: "native event updates widget state")
            control.fire()
            renderer.render(content)
            require(condition: counter.count == 2 && control.getText() == "Count 2", message: "retained native action uses the current widget state")
            require(condition: application.scene().lookup("#native-counter") == control, message: "native extension retains its node across updates")
            verification.completed = true
            printLine("Native controls verified")
          }
          case _ { throw Exception(message: "Native counter did not mount") }
        }
      } catch Exception failure { verification.failure = failure.message }
      finally { application.close() }
    })
  }, dispose: () { renderer.close() theme.close() })
  require(condition: verification.completed,
    message: if verification.failure == null { "Native extension verification did not complete" } else { verification.failure!! })
}
