package gallery

import ui.Widget

value GalleryPage {
  String name
  String chinese
  String category
  String summary
  String whenToUse
  String source
  String symbol
  String api
  String apiSymbol
  Function<Widget()> create
}

List<GalleryPage> galleryPages() {
  [
    GalleryPage(name: "Button", chinese: "按钮", category: "通用", summary: "按钮发起即时操作，并通过主次、状态和图标表达操作的性质。", whenToUse: "用于提交、保存、打开等明确动作。一个操作区域应突出最重要的动作，其余操作保持次要视觉层级；耗时操作期间可切换加载状态，避免重复触发。", source: "samples/gallery/general.norm", symbol: "ButtonExample", api: "ui/component/general.norm", apiSymbol: "Button", create: () { ButtonExample() }),
    GalleryPage(name: "FloatButton", chinese: "悬浮按钮", category: "通用", summary: "悬浮按钮把重要的辅助操作固定在一个 StackPane 的角落。", whenToUse: "适合在可滚动工作区中始终可见的反馈、返回或快捷操作。把它附着到明确的容器，避免覆盖表单提交和主要内容。", source: "samples/gallery/general.norm", symbol: "FloatButtonExample", api: "ui/component/general.norm", apiSymbol: "FloatButton", create: () { FloatButtonExample() }),
    GalleryPage(name: "Icon", chinese: "图标", category: "通用", summary: "图标使用 Ikonli 的图标字面量，在 JavaFX 场景图中绘制可缩放符号。", whenToUse: "适合为常见操作补充视觉线索。需要清晰的动作名称时，让图标与文字共同出现；不要只凭图形传达关键操作。", source: "samples/gallery/general.norm", symbol: "IconExample", api: "ui/component/general.norm", apiSymbol: "Icon", create: () { IconExample() }),
    GalleryPage(name: "Typography", chinese: "排版", category: "通用", summary: "在同一套主题中呈现标题与正文，并按需提供复制和内联编辑。", whenToUse: "适合文档标题、说明文字和可轻量修改的短文本。需要多行编辑或复杂校验时，应使用专门的输入控件。", source: "samples/gallery/general.norm", symbol: "TypographyExample", api: "ui/component/general.norm", apiSymbol: "Typography", create: () { TypographyExample() }),
    GalleryPage(name: "Divider", chinese: "分割线", category: "布局", summary: "分割线以水平或垂直方向区分相邻内容。", whenToUse: "当两个内容组需要视觉边界、却仍属于同一页面时使用。先用间距建立层次，再用分割线强化边界，避免每个元素都画线。", source: "samples/gallery/layout.norm", symbol: "DividerExample", api: "ui/component/layout.norm", apiSymbol: "Divider", create: () { DividerExample() }),
    GalleryPage(name: "Flex", chinese: "弹性布局", category: "布局", summary: "弹性布局把多个子组件放在同一行或列，并支持对齐、按权重扩展和换行。", whenToUse: "适合工具栏、操作组与宽度会变化的任务区域。内容可能溢出时开启换行；需要固定比例分栏时可设置子节点的扩展权重。", source: "samples/gallery/layout.norm", symbol: "FlexExample", api: "ui/component/layout.norm", apiSymbol: "Flex", create: () { FlexExample() }),
    GalleryPage(name: "Grid", chinese: "栅格", category: "布局", summary: "栅格按照容器宽度选择列数，并让项目占据一列或连续多列。", whenToUse: "适合卡片总览、指标面板与响应式模块布局。先确定可用宽度断点，再为重点模块设置跨列宽度。", source: "samples/gallery/layout.norm", symbol: "GridExample", api: "ui/component/layout.norm", apiSymbol: "Grid", create: () { GridExample() }),
    GalleryPage(name: "Layout", chinese: "布局", category: "布局", summary: "布局组件提供上、下、左、右和中心区域，便于搭建应用骨架。", whenToUse: "适合窗口级导航、工作区和主内容分区。把核心内容放在中心区域，并让边栏保持可预测的最小宽度。", source: "samples/gallery/layout.norm", symbol: "LayoutExample", api: "ui/component/layout.norm", apiSymbol: "Layout", create: () { LayoutExample() }),
    GalleryPage(name: "Masonry", chinese: "瀑布流", category: "布局", summary: "瀑布流把不同高度的卡片依次放到当前最短的列，减少不规则内容之间的空隙。", whenToUse: "适合图库、收藏和高度不一致的内容卡片。列宽应满足卡片可读性；内容变化时组件会重新计算列数与位置。", source: "samples/gallery/layout.norm", symbol: "MasonryExample", api: "ui/component/layout.norm", apiSymbol: "Masonry", create: () { MasonryExample() }),
    GalleryPage(name: "Space", chinese: "间距", category: "布局", summary: "间距组件把一组节点按统一水平距离排列，适合紧凑的同类操作。", whenToUse: "用于保存、预览、取消等同层级操作的成组排列。它只管理节点之间的距离，较复杂的换行或伸缩布局应选 Flex。", source: "samples/gallery/layout.norm", symbol: "SpaceExample", api: "ui/component/layout.norm", apiSymbol: "Space", create: () { SpaceExample() }),
    GalleryPage(name: "Splitter", chinese: "分隔面板", category: "布局", summary: "分隔面板允许用户拖动分隔条，重新分配相邻内容区域的空间。", whenToUse: "适合文件列表与编辑器、编辑与预览等需要临时调整空间的界面。为两侧内容留出足够的最小可用尺寸。", source: "samples/gallery/layout.norm", symbol: "SplitterExample", api: "ui/component/layout.norm", apiSymbol: "Splitter", create: () { SplitterExample() }),
    GalleryPage(name: "Anchor", chinese: "锚点", category: "导航", summary: "锚点把目录条目与 ScrollPane 中的目标节点关联，用于快速跳转长内容。", whenToUse: "适合有多个章节的说明页、表单或设置页。目录文本应与实际章节一致，目标节点必须位于关联的滚动内容中。", source: "samples/gallery/navigation.norm", symbol: "AnchorExample", api: "ui/component/navigation.norm", apiSymbol: "Anchor", create: () { AnchorExample() }),
    GalleryPage(name: "Breadcrumb", chinese: "面包屑", category: "导航", summary: "面包屑按层级显示当前位置，并允许用户回到路径中的上级节点。", whenToUse: "适合项目、文件夹或文档等层层进入的界面。保持路径层级清晰，每一项应对应真实导航动作。", source: "samples/gallery/navigation.norm", symbol: "BreadcrumbExample", api: "ui/component/navigation.norm", apiSymbol: "Breadcrumb", create: () { BreadcrumbExample() }),
    GalleryPage(name: "Dropdown", chinese: "下拉菜单", category: "导航", summary: "下拉菜单把不常用的操作收纳到触发按钮后面，以浮层呈现任意子组件。", whenToUse: "适合文档操作、更多选项等次要动作集合。菜单项宜简短且可辨认，主要操作仍应直接可见。", source: "samples/gallery/navigation.norm", symbol: "DropdownExample", api: "ui/component/navigation.norm", apiSymbol: "Dropdown", create: () { DropdownExample() }),
    GalleryPage(name: "Menu", chinese: "导航菜单", category: "导航", summary: "菜单栏按文件、编辑、视图等任务组织命令，支持键盘导航和分组操作。", whenToUse: "适合持续使用的桌面工作区，而不是少量临时操作。菜单标题按任务命名，并把实际动作绑定到每个 MenuItem。", source: "samples/gallery/navigation.norm", symbol: "MenuExample", api: "ui/component/navigation.norm", apiSymbol: "Menu", create: () { MenuExample() }),
    GalleryPage(name: "Pagination", chinese: "分页", category: "导航", summary: "分页组件记录总条数、每页条数和当前页，并提供前一页、后一页操作。", whenToUse: "适合已分组的大量记录。页面内容需要由调用方根据 currentPage 与 pageSize 选择和刷新，分页组件自身不持有数据源。", source: "samples/gallery/navigation.norm", symbol: "PaginationExample", api: "ui/component/navigation.norm", apiSymbol: "Pagination", create: () { PaginationExample() }),
    GalleryPage(name: "Steps", chinese: "步骤条", category: "导航", summary: "步骤条表示有顺序的流程阶段，明确当前步骤及已完成、待完成部分。", whenToUse: "适合填写资料、确认内容、提交结果等线性流程。步骤状态应由实际业务进度驱动，而不是仅凭视觉跳转代替数据校验。", source: "samples/gallery/navigation.norm", symbol: "StepsExample", api: "ui/component/navigation.norm", apiSymbol: "Steps", create: () { StepsExample() }),
    GalleryPage(name: "Tabs", chinese: "标签页", category: "导航", summary: "标签页在同一区域切换不同内容视图，保留紧凑的页面层级。", whenToUse: "适合项目概览、成员和设置等平级视图。每个标签应有明确标题，并把互不相关的流程分到独立页面。", source: "samples/gallery/navigation.norm", symbol: "TabsExample", api: "ui/component/navigation.norm", apiSymbol: "Tabs", create: () { TabsExample() }),
    GalleryPage(name: "AutoComplete", chinese: "自动完成", category: "数据录入", summary: "输入文字时展示匹配建议，并将选中的建议作为当前值。", whenToUse: "适合城市、项目等候选项较多且用户知道关键词的场景。若只需从少量固定选项中选择，直接使用 Select 更清楚。", source: "samples/gallery/inputs.norm", symbol: "AutoCompleteExample", api: "ui/component/inputs.norm", apiSymbol: "AutoComplete", create: () { AutoCompleteExample() }),
    GalleryPage(name: "Cascader", chinese: "级联选择", category: "数据录入", summary: "通过连续的下拉层级选择一条路径，当前值是一组按层级排列的节点值。", whenToUse: "适合地区、组织等天然有父子关系的选项。若只有单层选项，使用 Select 可减少一次层级操作。", source: "samples/gallery/inputs.norm", symbol: "CascaderExample", api: "ui/component/inputs.norm", apiSymbol: "Cascader", create: () { CascaderExample() }),
    GalleryPage(name: "Checkbox", chinese: "多选框", category: "数据录入", summary: "独立开关式选择项，多个选项可以同时选中。", whenToUse: "适合并列偏好、权限等可同时成立的选择。互斥选项应使用 Radio，立即生效的单一设置可使用 Switch。", source: "samples/gallery/inputs.norm", symbol: "CheckboxExample", api: "ui/component/inputs.norm", apiSymbol: "Checkbox", create: () { CheckboxExample() }),
    GalleryPage(name: "ColorPicker", chinese: "颜色选择器", category: "数据录入", summary: "将颜色选择与透明度调节组合，统一给出包含 alpha 的 Color 值。", whenToUse: "适合可视化配置品牌色、文字色和背景色。颜色会直接影响可读性，应用时应在实际内容上预览。", source: "samples/gallery/inputs.norm", symbol: "ColorPickerExample", api: "ui/component/inputs.norm", apiSymbol: "ColorPicker", create: () { ColorPickerExample() }),
    GalleryPage(name: "DatePicker", chinese: "日期选择框", category: "数据录入", summary: "选择单日，或用 DateRangePicker 将开始与结束日期作为一个区间值。", whenToUse: "适合预约日期、旅行计划等日历日期，不适合表达具体时刻；时刻另用 TimePicker。", source: "samples/gallery/inputs.norm", symbol: "DatePickerExample", api: "ui/component/inputs.norm", apiSymbol: "DatePicker", create: () { DatePickerExample() }),
    GalleryPage(name: "Form", chinese: "表单", category: "数据录入", summary: "把输入控件、验证条件、提交动作与重置行为组织在一起。", whenToUse: "适合需要收集多项信息并统一确认的流程。单独一个输入项通常无需引入 Form。", source: "samples/gallery/inputs.norm", symbol: "FormExample", api: "ui/component/inputs.norm", apiSymbol: "Form", create: () { FormExample() }),
    GalleryPage(name: "Input", chinese: "输入框", category: "数据录入", summary: "提供单行、密码和多行输入模式，通过 Binding 连接文本状态。", whenToUse: "适合姓名、搜索词、密码和短备注等自由文本。结构化数字、日期或固定选项应使用对应的专用控件。", source: "samples/gallery/inputs.norm", symbol: "InputExample", api: "ui/component/inputs.norm", apiSymbol: "Input", create: () { InputExample() }),
    GalleryPage(name: "InputNumber", chinese: "数字输入框", category: "数据录入", summary: "使用 BigDecimal 表达有边界、有步长的数字，支持精度设置与编辑器输入。", whenToUse: "适合金额、数量等需要明确范围和增减步长的值。金额尤其应使用十进制值，避免二进制浮点误差。", source: "samples/gallery/inputs.norm", symbol: "InputNumberExample", api: "ui/component/inputs.norm", apiSymbol: "InputNumber", create: () { InputNumberExample() }),
    GalleryPage(name: "Mentions", chinese: "提及", category: "数据录入", summary: "在多行消息里输入 @ 提及预置候选人或团队，选择后把完整提及插入光标位置。", whenToUse: "适合协作消息和工单分派等需要在自然语言中指向具体对象的场景。纯粹选择人员时，Select 更直接。", source: "samples/gallery/inputs.norm", symbol: "MentionsExample", api: "ui/component/inputs.norm", apiSymbol: "Mentions", create: () { MentionsExample() }),
    GalleryPage(name: "Radio", chinese: "单选框", category: "数据录入", summary: "一组互斥选项中的单选控件，通过同一组选中值保持选项互斥。", whenToUse: "适合配送、支付等选项较少、需要同时看见全部候选值的场景。选项很多时可改用 Select。", source: "samples/gallery/inputs.norm", symbol: "RadioExample", api: "ui/component/inputs.norm", apiSymbol: "Radio", create: () { RadioExample() }),
    GalleryPage(name: "Rate", chinese: "评分", category: "数据录入", summary: "用可选中的星级表达整数评分，默认五级，也可设置其他最大等级。", whenToUse: "适合满意度、商品体验等离散主观评价。连续数值范围或精确金额应使用 Slider 或 InputNumber。", source: "samples/gallery/inputs.norm", symbol: "RateExample", api: "ui/component/inputs.norm", apiSymbol: "Rate", create: () { RateExample() }),
    GalleryPage(name: "Select", chinese: "选择器", category: "数据录入", summary: "从候选项中选择一个值，也提供带搜索过滤的单选组合和多选弹层。", whenToUse: "适合方案、团队等选项明确且数量中等的场景。用户需要自由输入和异步建议时可使用 AutoComplete。", source: "samples/gallery/inputs.norm", symbol: "SelectExample", api: "ui/component/inputs.norm", apiSymbol: "Select", create: () { SelectExample() }),
    GalleryPage(name: "Slider", chinese: "滑动输入条", category: "数据录入", summary: "通过拖动滑块调整连续数值；Range 将起点与终点组合成一个受约束区间。", whenToUse: "适合预算和价格区间等更关注大致位置的数值。需要精确键入时使用 InputNumber。", source: "samples/gallery/inputs.norm", symbol: "SliderExample", api: "ui/component/inputs.norm", apiSymbol: "Slider", create: () { SliderExample() }),
    GalleryPage(name: "Switch", chinese: "开关", category: "数据录入", summary: "表达一个可立即切换的开/关状态，通过 Binding 连接布尔状态。", whenToUse: "适合通知、在线状态等立即生效的设置。若用户需要先勾选多个条件再统一提交，使用 Checkbox。", source: "samples/gallery/inputs.norm", symbol: "SwitchExample", api: "ui/component/inputs.norm", apiSymbol: "Switch", create: () { SwitchExample() }),
    GalleryPage(name: "TimePicker", chinese: "时间选择框", category: "数据录入", summary: "按可配置的分钟步长列出可选时间，并可限定一天内允许选择的时段。", whenToUse: "适合预约开始时间、工作时段等只关心时分的输入。涉及日期时应与 DatePicker 分开建模。", source: "samples/gallery/inputs.norm", symbol: "TimePickerExample", api: "ui/component/inputs.norm", apiSymbol: "TimePicker", create: () { TimePickerExample() }),
    GalleryPage(name: "Transfer", chinese: "穿梭框", category: "数据录入", summary: "用左右两个可多选列表在可用项与已选项之间移动数据。", whenToUse: "适合从较长候选列表中分配项目成员或权限。候选项很少时，Checkbox 更紧凑。", source: "samples/gallery/inputs.norm", symbol: "TransferExample", api: "ui/component/inputs.norm", apiSymbol: "Transfer", create: () { TransferExample() }),
    GalleryPage(name: "TreeSelect", chinese: "树选择", category: "数据录入", summary: "在树形弹层中选择一个节点，并在触发按钮上显示该节点值。", whenToUse: "适合商品分类和组织结构等需要理解上下级关系的单项选择。若必须保留完整路径值，使用 Cascader。", source: "samples/gallery/inputs.norm", symbol: "TreeSelectExample", api: "ui/component/inputs.norm", apiSymbol: "TreeSelect", create: () { TreeSelectExample() }),
    GalleryPage(name: "Upload", chinese: "上传", category: "数据录入", summary: "选择或拖入本地文件，交给调用方提供的异步上传器处理，并展示每个文件的状态与进度。", whenToUse: "适合用户提交附件、素材或多份文件。上传目标和传输方式属于应用逻辑，由 uploader 决定。", source: "samples/gallery/inputs.norm", symbol: "UploadExample", api: "ui/component/inputs.norm", apiSymbol: "Upload", create: () { UploadExample() }),
    GalleryPage(name: "Avatar", chinese: "头像", category: "数据展示", summary: "以文字缩写或图片表示一个人、团队或对象。", whenToUse: "适合成员列表、评论和工作区标识。图片会在头像内居中裁切；需要完整展示图片时使用 Image。", source: "samples/gallery/display.norm", symbol: "AvatarExample", api: "ui/component/display.norm", apiSymbol: "Avatar", create: () { AvatarExample() }),
    GalleryPage(name: "Badge", chinese: "徽标数", category: "数据展示", summary: "在任意子组件角落显示未处理数量。", whenToUse: "适合收件箱、通知和待办计数。把需要标记的内容节点交给 Badge，业务数据变化时更新 count。", source: "samples/gallery/display.norm", symbol: "BadgeExample", api: "ui/component/display.norm", apiSymbol: "Badge", create: () { BadgeExample() }),
    GalleryPage(name: "Calendar", chinese: "日历", category: "数据展示", summary: "以整月网格显示日期，并允许选择具体一天。", whenToUse: "适合排期、预约和每日事件概览。需要只输入一个日期时使用 DatePicker；需要同时看整月内容时使用 Calendar。", source: "samples/gallery/display.norm", symbol: "CalendarExample", api: "ui/component/display.norm", apiSymbol: "Calendar", create: () { CalendarExample() }),
    GalleryPage(name: "Card", chinese: "卡片", category: "数据展示", summary: "用标题和内容节点组织一块独立信息。", whenToUse: "适合项目摘要、统计分组和任务概览。内容有独立主题和操作时可用卡片；纯文本分隔通常无需卡片。", source: "samples/gallery/display.norm", symbol: "CardExample", api: "ui/component/display.norm", apiSymbol: "Card", create: () { CardExample() }),
    GalleryPage(name: "Carousel", chinese: "走马灯", category: "数据展示", summary: "在同一位置轮流展示多个子组件。", whenToUse: "适合图片、公告和同级内容的轮播。重要操作不应只放在会自动离开的幻灯片里。", source: "samples/gallery/display.norm", symbol: "CarouselExample", api: "ui/component/display.norm", apiSymbol: "Carousel", create: () { CarouselExample() }),
    GalleryPage(name: "Collapse", chinese: "折叠面板", category: "数据展示", summary: "通过标题展开或收起一块内容。", whenToUse: "适合常见问题、次要设置和按需阅读的说明。核心操作和必须立即看到的信息应直接展示。", source: "samples/gallery/display.norm", symbol: "CollapseExample", api: "ui/component/display.norm", apiSymbol: "Collapse", create: () { CollapseExample() }),
    GalleryPage(name: "Descriptions", chinese: "描述列表", category: "数据展示", summary: "将一组名称和值按两列逐行排布，值可以是任意子组件。", whenToUse: "适合订单、项目和用户资料等只读详情。需要编辑字段和校验时使用 Form。", source: "samples/gallery/display.norm", symbol: "DescriptionsExample", api: "ui/component/display.norm", apiSymbol: "Descriptions", create: () { DescriptionsExample() }),
    GalleryPage(name: "Empty", chinese: "空状态", category: "数据展示", summary: "用简短说明表达当前容器没有可展示内容，并可配合外部操作。", whenToUse: "适合首次使用、无搜索结果和无通知等状态。应说明缺少什么，并给用户提供合适的下一步。", source: "samples/gallery/display.norm", symbol: "EmptyExample", api: "ui/component/display.norm", apiSymbol: "Empty", create: () { EmptyExample() }),
    GalleryPage(name: "Image", chinese: "图片", category: "数据展示", summary: "展示图片，并可在点击时打开原图预览。", whenToUse: "适合图库、内容预览和详情配图。需要小尺寸人物标识时使用 Avatar；需要完整图片和放大查看时使用 Image。", source: "samples/gallery/display.norm", symbol: "ImageExample", api: "ui/component/display.norm", apiSymbol: "Image", create: () { ImageExample() }),
    GalleryPage(name: "List", chinese: "列表", category: "数据展示", summary: "列表以统一布局展示一组同类信息。", whenToUse: "需要单列展示、选择数据时使用 ListView。列表数据使用 Norm List<T>，更长的内容可选择 Listy。", source: "samples/gallery/display.norm", symbol: "ListViewExample", api: "ui/component/display.norm", apiSymbol: "ListView", create: () { ListViewExample() }),
    GalleryPage(name: "Listy", chinese: "虚拟列表", category: "数据展示", summary: "针对大量等高条目设置固定单元高度的列表，沿用 ListView 的选择与滚动能力。", whenToUse: "适合日志、事件流等大量同质记录。若每行高度随内容变化，应先评估固定行高是否合适。", source: "samples/gallery/display.norm", symbol: "ListyExample", api: "ui/component/display.norm", apiSymbol: "Listy", create: () { ListyExample() }),
    GalleryPage(name: "Popover", chinese: "气泡卡片", category: "数据展示", summary: "在触发点附近展示一小块补充内容，内容可以包含任意子组件。", whenToUse: "适合项目详情、成员摘要和轻量操作。只需要一句解释时使用 Tooltip；需要完整编辑流程时使用 Drawer。", source: "samples/gallery/overlays.norm", symbol: "PopoverExample", api: "ui/component/feedback.norm", apiSymbol: "Popover", create: () { PopoverExample() }),
    GalleryPage(name: "QRCode", chinese: "二维码", category: "数据展示", summary: "将文字即时编码为二维码图片。", whenToUse: "适合分享链接、设备配对和票据内容。编码前应确认文本确实是用户希望传递的数据。", source: "samples/gallery/display.norm", symbol: "QRCodeExample", api: "ui/component/display.norm", apiSymbol: "QRCode", create: () { QRCodeExample() }),
    GalleryPage(name: "Segmented", chinese: "分段控制器", category: "数据展示", summary: "在一组同级选项中快速切换单个当前值。", whenToUse: "适合日、周、月等互斥视图和简短模式选择。选项较多或文字较长时应使用其他选择控件。", source: "samples/gallery/display.norm", symbol: "SegmentedExample", api: "ui/component/display.norm", apiSymbol: "Segmented", create: () { SegmentedExample() }),
    GalleryPage(name: "Statistic", chinese: "统计数值", category: "数据展示", summary: "突出显示一项数值及其标题，数值变化时立即重排显示。", whenToUse: "适合仪表盘、结果摘要和实时计数。多个指标可并排组合；趋势和上下文应由周围内容说明。", source: "samples/gallery/display.norm", symbol: "StatisticExample", api: "ui/component/display.norm", apiSymbol: "Statistic", create: () { StatisticExample() }),
    GalleryPage(name: "Table", chinese: "表格", category: "数据展示", summary: "以列定义展示结构化行数据，并支持选择、排序和单元格编辑。", whenToUse: "适合需要比较多个字段、筛选或排序的数据集合。简单单列条目可使用 List。", source: "samples/gallery/display.norm", symbol: "TableExample", api: "ui/component/display.norm", apiSymbol: "Table", create: () { TableExample() }),
    GalleryPage(name: "Tag", chinese: "标签", category: "数据展示", summary: "用短标签标记状态、分类或属性。", whenToUse: "适合少量简短分类和筛选条件。较长的解释性内容应使用正文而非标签。", source: "samples/gallery/display.norm", symbol: "TagExample", api: "ui/component/display.norm", apiSymbol: "Tag", create: () { TagExample() }),
    GalleryPage(name: "Timeline", chinese: "时间轴", category: "数据展示", summary: "按顺序展示带时间标记的事件内容。", whenToUse: "适合构建记录、审批过程和操作历史。事件顺序由添加顺序决定，组件不会自行按时间排序。", source: "samples/gallery/display.norm", symbol: "TimelineExample", api: "ui/component/display.norm", apiSymbol: "Timeline", create: () { TimelineExample() }),
    GalleryPage(name: "Tooltip", chinese: "文字提示", category: "数据展示", summary: "为操作补充短文本说明，支持鼠标悬停和键盘聚焦。", whenToUse: "适合图标含义、操作结果预告和简短辅助提示。必读信息应直接放在页面中，不依赖悬停才能发现。", source: "samples/gallery/overlays.norm", symbol: "TooltipExample", api: "ui/component/feedback.norm", apiSymbol: "Tooltip", create: () { TooltipExample() }),
    GalleryPage(name: "Tour", chinese: "漫游式引导", category: "数据展示", summary: "按顺序将简短说明定位到已有控件，帮助首次使用者完成入门。", whenToUse: "适合少量关键操作的引导。先让目标控件出现在当前页面，再开始引导；完整帮助应保留为可随时阅读的文档。", source: "samples/gallery/overlays.norm", symbol: "TourExample", api: "ui/component/feedback.norm", apiSymbol: "Tour", create: () { TourExample() }),
    GalleryPage(name: "Tree", chinese: "树形控件", category: "数据展示", summary: "以可展开层级展示父子关系，通过 Binding 连接选中项。", whenToUse: "适合文件目录、组织结构和分层导航。数据具有父子关系时使用 Tree；平面条目使用 List。", source: "samples/gallery/display.norm", symbol: "TreeExample", api: "ui/component/display.norm", apiSymbol: "Tree", create: () { TreeExample() }),
    GalleryPage(name: "Alert", chinese: "警告提示", category: "反馈", summary: "在页面内容中持续展示需要注意的消息。", whenToUse: "适合同步状态、离线说明和需要处理的事项。短暂的操作回执使用 Message，独立的通知使用 Notification。", source: "samples/gallery/status.norm", symbol: "AlertExample", api: "ui/component/status.norm", apiSymbol: "Alert", create: () { AlertExample() }),
    GalleryPage(name: "Drawer", chinese: "抽屉", category: "反馈", summary: "从应用边缘展开补充面板，在保留页面上下文的同时完成编辑。", whenToUse: "适合详情、设置和短表单。需要阻止所属窗口中的其他交互时，考虑 Modal。", source: "samples/gallery/overlays.norm", symbol: "DrawerExample", api: "ui/component/feedback.norm", apiSymbol: "Drawer", create: () { DrawerExample() }),
    GalleryPage(name: "Message", chinese: "全局提示", category: "反馈", summary: "在所属 App 顶部展示简短、短暂的操作反馈。", whenToUse: "适合保存成功、提交结果和简短状态回执。包含复杂内容或需要手动关闭时使用 Notification。", source: "samples/gallery/status.norm", symbol: "MessageExample", api: "ui/component/notices.norm", apiSymbol: "Message", create: () { MessageExample() }),
    GalleryPage(name: "Modal", chinese: "对话框", category: "反馈", summary: "在独立的模态窗口中完成需要明确确认或取消的操作。", whenToUse: "适合重要设置、确认信息和较复杂的输入。内容少且需要靠近触发点时使用 Popconfirm。", source: "samples/gallery/overlays.norm", symbol: "ModalExample", api: "ui/component/feedback.norm", apiSymbol: "Modal", create: () { ModalExample() }),
    GalleryPage(name: "Notification", chinese: "通知提醒框", category: "反馈", summary: "在应用角落展示带标题和内容的通知，可由用户手动关闭。", whenToUse: "适合任务完成、团队消息和比 Message 更详细的结果说明。消息内容可组合文字、按钮和其他节点。", source: "samples/gallery/status.norm", symbol: "NotificationExample", api: "ui/component/notices.norm", apiSymbol: "Notification", create: () { NotificationExample() }),
    GalleryPage(name: "Popconfirm", chinese: "气泡确认框", category: "反馈", summary: "在触发点旁询问一个明确的问题，确认后才执行回调。", whenToUse: "适合移除条目等范围小、后果明确的操作。需要展示复杂信息或填写内容时使用 Modal。", source: "samples/gallery/overlays.norm", symbol: "PopconfirmExample", api: "ui/component/feedback.norm", apiSymbol: "Popconfirm", create: () { PopconfirmExample() }),
    GalleryPage(name: "Progress", chinese: "进度条", category: "反馈", summary: "用进度条表达任务完成比例，也可以表示尚未确定进度的等待。", whenToUse: "适合下载、导出和批处理。知道总量时显示确定进度；没有可靠比例时避免展示猜测值。", source: "samples/gallery/status.norm", symbol: "ProgressExample", api: "ui/component/status.norm", apiSymbol: "Progress", create: () { ProgressExample() }),
    GalleryPage(name: "Result", chinese: "结果", category: "反馈", summary: "在流程结束或无结果时集中显示标题、说明和下一步操作。", whenToUse: "适合创建完成、提交结果和搜索未命中。单个列表缺少数据时通常使用更轻量的 Empty。", source: "samples/gallery/status.norm", symbol: "ResultExample", api: "ui/component/status.norm", apiSymbol: "Result", create: () { ResultExample() }),
    GalleryPage(name: "Skeleton", chinese: "骨架屏", category: "反馈", summary: "在内容尚未准备好时，用占位行表达即将出现的信息结构。", whenToUse: "适合首次加载文本摘要，减少突然出现大段内容的跳动。已有内容正在更新时，可保留内容并用 Spin 提示。", source: "samples/gallery/status.norm", symbol: "SkeletonExample", api: "ui/component/status.norm", apiSymbol: "Skeleton", create: () { SkeletonExample() }),
    GalleryPage(name: "Spin", chinese: "加载中", category: "反馈", summary: "在现有内容上叠加加载指示，表达当前区域正在等待。", whenToUse: "适合局部同步和短暂加载。整个页面首次加载且结构已知时可考虑 Skeleton。", source: "samples/gallery/status.norm", symbol: "SpinExample", api: "ui/component/status.norm", apiSymbol: "Spin", create: () { SpinExample() }),
    GalleryPage(name: "Watermark", chinese: "水印", category: "反馈", summary: "在内容上叠加重复文字，表达资料归属或使用范围。", whenToUse: "适合内部资料、预览和文档区域标记。水印文字应简短，保证正文和表单仍清晰可读。", source: "samples/gallery/status.norm", symbol: "WatermarkExample", api: "ui/component/status.norm", apiSymbol: "Watermark", create: () { WatermarkExample() }),
    GalleryPage(name: "Affix", chinese: "固钉", category: "其他", summary: "让一组操作在指定滚动容器内到达顶部后保持可见。", whenToUse: "适合长文档的保存操作或区域工具栏。需要明确绑定对应 ScrollPane，避免工具栏与错误的滚动区域联动。", source: "samples/gallery/status.norm", symbol: "AffixExample", api: "ui/component/status.norm", apiSymbol: "Affix", create: () { AffixExample() }),
    GalleryPage(name: "App", chinese: "包裹组件", category: "其他", summary: "为一棵 Widget 组件树提供主题、局部服务和资源归属。", whenToUse: "作为 Widget 树的组件根容器使用。每个 App 拥有独立的消息与通知服务，不需要全局单例。", source: "samples/gallery/status.norm", symbol: "AppExample", api: "ui/component/configuration.norm", apiSymbol: "App", create: () { AppExample() }),
    GalleryPage(name: "BorderBeam", chinese: "边框流光", category: "其他", summary: "沿内容边缘播放缓慢移动的强调线，吸引注意但不覆盖内容。", whenToUse: "适合少量重点入口或新功能展示。同屏不要让大量区域同时运动；优先让内容本身说明价值。", source: "samples/gallery/status.norm", symbol: "BorderBeamExample", api: "ui/component/status.norm", apiSymbol: "BorderBeam", create: () { BorderBeamExample() }),
    GalleryPage(name: "ConfigProvider", chinese: "全局化配置", category: "其他", summary: "在组件子树内覆盖字体、密度、圆角和动效配置，并承接主题。", whenToUse: "适合同一窗口中的紧凑工具栏、宽松表单或需要减弱动效的区域。局部设置只影响其后代节点。", source: "samples/gallery/status.norm", symbol: "ConfigProviderExample", api: "ui/component/configuration.norm", apiSymbol: "ConfigProvider", create: () { ConfigProviderExample() }),
    GalleryPage(name: "Util", chinese: "工具类", category: "其他", summary: "使用共享的组件组合和生命周期基础能力。", whenToUse: "普通业务组件使用 Widget、Binding 与 Surface，原生资源管理保留在 ui.component.fx 内。", source: "samples/gallery/status.norm", symbol: "UtilExample", api: "ui/component/surface.norm", apiSymbol: "Surface", create: () { UtilExample() })
  ]
}
