package gallery

import std.testing.Test
import ui.component.transfer
import ui.component.segmented
import ui.component.cascader
import ui.component.cascaderItem
import ui.component.CascaderItem
import ui.component.tour
import ui.component.autoCompleteSuggestions
import ui.component.mentionsSuggestions
import ui.component.autoCompleteNew
import ui.component.mentionsNew
import ui.component.buttonNew
import ui.component.tourStepNew
import ui.component.TourStep

@Test
Void normListsCreateCollectionControls() {
  try {
    fxHarnessRun(() {
      List<String> source = List<>()
      source.add("First")
      source.add("Second")
      var transferControl = transfer(source)
      require(condition: transferControl.getAvailableItems()!!.size() == 2, message: "transfer accepts Norm List")
      source.add("Third")
      require(condition: transferControl.getAvailableItems()!!.size() == 2, message: "Norm List is copied at construction")
      transferControl.select("First")
      require(condition: transferControl.getSelectedItems()!!.get(0) == "First", message: "transfer keeps element identity")

      var segments = segmented(source)
      segments.setValue("Second")
      require(condition: segments.getValue() == "Second", message: "segmented accepts Norm List")

      List<CascaderItem<String?>> noChildren = List<>()
      var leaf = cascaderItem(value: "leaf", label: "Leaf", children: noChildren)
      List<CascaderItem<String?>> leafChildren = List<>()
      leafChildren.add(leaf)
      var branch = cascaderItem(value: "branch", label: "Branch", children: leafChildren)
      List<CascaderItem<String?>> roots = List<>()
      roots.add(branch)
      var choices = cascader(roots)
      require(condition: choices.getItems()!!.size() == 1, message: "cascader accepts nested Norm Lists")
      require(condition: branch.children()!!.size() == 1, message: "cascader retains nested children")

      var step = tourStepNew(arg0: buttonNew("Target"), arg1: "Start", arg2: "Description")
      List<TourStep> steps = List<>()
      steps.add(step)
      var guide = tour(steps)
      require(condition: guide.getIndex() == -1, message: "tour accepts Norm List")
      guide.close()

      var completion = autoCompleteNew()
      autoCompleteSuggestions(control: completion, values: source)
      require(condition: completion.getSuggestions()!!.size() == 3, message: "autocomplete accepts Norm List")
      var mentions = mentionsNew()
      mentionsSuggestions(control: mentions, values: source)
      require(condition: mentions.getSuggestions()!!.size() == 3, message: "mentions accepts Norm List")
    })
  } finally { fxHarnessStop() }
}
