package gallery

import std.testing.Test
import std.core.Unit
import std.concurrent.completion
import std.concurrent.startTask
import std.concurrent.delay
import std.time.duration
import std.filesystem.Path
import ui.component.Upload
import ui.component.uploadNew
import ui.component.uploadFiles

@Test
Void uploadAcceptsNormTaskAndPath() {
  var created = completion<Upload>()
  var finished = completion<Boolean>()
  try {
    fxHarnessRun(() {
      var upload = uploadNew()
      upload.setUploader((file) {
        require(condition: file != null, message: "upload receives a Norm path")
        startTask<Unit?>(() { null })
      })
      List<Path> files = List<>()
      files.add(Path(value: "samples/gallery/module.norm"))
      uploadFiles(upload: upload, files: files)
      created.succeed(upload)
      return
    })
    var upload = created.task().await()
    try {
      for attempt : range(start: 0, end: 100) {
        fxHarnessRun(() {
          if upload.getItems()!!.get(0)!!.getProgress() == 1.0 {
            finished.succeed(true)
          }
        })
        if finished.task().completed() { break }
        delay(duration(seconds: 0, nanoseconds: 50000000))
      }
      require(condition: finished.task().completed(), message: "Norm asynchronous upload reaches completion")
    } finally {
      fxHarnessRun(() { upload.close() })
    }
  } finally {
    finished.close()
    created.close()
    fxHarnessStop()
  }
}
