package gallery

import std.testing.Test
import theme.Color
import theme.ThemeDefinition
import theme.ThemeManager
import theme.ThemeMode
import theme.ThemeOverride
import theme.generateTheme
import ui.component.app
import ui.component.inputNew
import ui.component.configProviderNew
import ui.component.connectTheme
import ui.component.themeCss
import fx.graphics.sceneNew
import fx.graphics.stageNew

@Test
Void liveThemePreservesInputAndLocalScope() {
  try {
    fxHarnessRun(() {
      var manager = ThemeManager(ThemeDefinition(primary: Color(hex: "#6750A4")))
      var scope = manager.scope(ThemeOverride(mode: ThemeMode.Dark))
      var input = inputNew("Live input")
      var provider = configProviderNew(input)
      connectTheme(provider: provider, theme: scope)
      var root = app(theme: manager, content: provider)
      var window = stageNew()
      window.setScene(sceneNew(arg0: root, arg1: 480.0, arg2: 300.0))
      window.show()
      try {
        var before = root.getThemeCss()
        var fixed = provider.getThemeCss()
        manager.setMode(ThemeMode.Dark)
        require(condition: before != root.getThemeCss(), message: "root theme changed")
        require(condition: fixed == provider.getThemeCss(), message: "local dark override stayed stable")
        require(condition: input.getText() == "Live input", message: "input kept its value")
        root.close()
        manager.setMode(ThemeMode.Light)
        require(condition: root.isClosed(), message: "root is closed")
      } finally {
        provider.close()
        root.close()
        scope.close()
        manager.close()
        window.close()
      }
    })
  } finally { fxHarnessStop() }
}

@Test
Void exportThemeFixtures() {
  var definition = ThemeDefinition(primary: Color(hex: "#6750A4"))
  gallerySaveThemes(
    arg0: themeCss(generateTheme(definition, mode: ThemeMode.Light)),
    arg1: themeCss(generateTheme(definition, mode: ThemeMode.Dark))
  )
}
